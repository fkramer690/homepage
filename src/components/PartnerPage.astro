---
// Cooperation partners for topics next to the Salesforce architecture work.
import Page from '../layouts/Page.astro';
import ExternalMark from './ExternalMark.astro';
import { Image } from 'astro:assets';
import julianeWinterscheid from '../assets/partners/juliane-winterscheid.png';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { localHref, partnersHref } from '../lib/paths';
import { recruiters, recruiterPaths } from '../data/recruiters';
import { getServices, serviceHref } from '../lib/services';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
const photos = { 'juliane-winterscheid': julianeWinterscheid };
const services = await getServices(lang);
const recruiterTeaser = recruiters[lang].teaser;
const serviceLinks = new Map(services.map((s) => [s.data.order, serviceHref(s)]));
---
<Page layout="wide" lang={lang} title={t.partnerPage.metaTitle} description={t.partnerPage.description} alternates={{ en: partnersHref('en'), de: partnersHref('de') }}>
  <header class="service-hero dark grid-bg">
    <div class="container">
      <p class="eyebrow mono">{lang === 'de' ? 'Partner' : 'Partners'}</p>
      <h1>{t.partnerPage.title}</h1>
      <p class="service-lead">{t.partnerPage.lead}</p>
    </div>
  </header>
  <section class="section blog">
    <div class="container">
      <p class="partner-intro">{t.partnerPage.intro}</p>
      {t.partnerPage.partners.map((p) => {
        const serviceLink = serviceLinks.get(p.service);
        return (
          <article class="partner-card">
            <figure>
              {p.profile
                ? <a href={localHref(lang, p.profile)}><Image src={photos[p.photo as keyof typeof photos]} alt={p.photoAlt} widths={[480]} /></a>
                : <Image src={photos[p.photo as keyof typeof photos]} alt={p.photoAlt} widths={[480]} />}
            </figure>
            <div class="partner-body">
              <p class="partner-area mono">{p.area}</p>
              <h2>{p.profile ? <a href={localHref(lang, p.profile)}>{p.name}</a> : p.name}</h2>
              <p>{p.text}</p>
              <p class="partner-links">
                <a href={p.linkedin} target="_blank" rel="noopener">{t.partnerPage.linkedIn}<ExternalMark label={t.nav.externalTab} /></a>
                {p.profile && <a href={localHref(lang, p.profile)}>{p.profileLink} →</a>}
                {serviceLink && <a href={serviceLink}>{p.serviceLink} →</a>}
              </p>
            </div>
          </article>
        );
      })}
      <section class="partner-recruiters" aria-labelledby="recruiters">
        <p class="partner-area mono">{recruiterTeaser.label}</p>
        <h2 id="recruiters">{recruiterTeaser.title}</h2>
        <p>{recruiterTeaser.text}</p>
        <p class="partner-links"><a href={localHref(lang, recruiterPaths[lang])}>{recruiterTeaser.link} →</a></p>
      </section>
    </div>
  </section>
</Page>
