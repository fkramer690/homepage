---
// Partner page, still empty: noindex and kept out of the sitemap until it has content.
import Page from '../layouts/Page.astro';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { partnersHref } from '../lib/paths';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
---
<Page lang={lang} title={t.partnerPage.metaTitle} description={t.partnerPage.description} alternates={{ en: partnersHref('en'), de: partnersHref('de') }} noindex>
  <section class="section blog">
    <div class="container">
      <p class="eyebrow mono">FK Solution Design</p>
      <h1>{t.partnerPage.title}</h1>
    </div>
  </section>
</Page>
