---
// Schema.org data so search engines understand who is behind the site.
import type { Dict } from '../i18n/en';
import { getImage } from 'astro:assets';
import { site } from '../site';
import portrait from '../assets/portrait.png';

interface Props {
  t: Dict;
  url: string;
}
const { t, url } = Astro.props;
const base = import.meta.env.BASE_URL;
const abs = (path: string) => new URL(path, Astro.site).href;
const l = site.legal;
const photo = await getImage({ src: portrait, width: 720, format: 'jpg' });

const data = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      // Gives Google the site name shown above the search result.
      '@type': 'WebSite',
      '@id': `${abs(base)}#website`,
      name: 'FK Solution Design',
      alternateName: site.company,
      url: abs(base),
      inLanguage: ['de', 'en'],
      publisher: { '@id': `${abs(base)}#organization` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${abs(base)}#organization`,
      name: site.company,
      url,
      description: t.meta.description,
      logo: abs(`${base}apple-touch-icon.png`),
      image: abs(`${base}og/${t.lang}/site.png`),
      email: site.email,
      telephone: site.phone.en,
      address: {
        '@type': 'PostalAddress',
        streetAddress: l.street,
        postalCode: l.city.split(' ')[0],
        addressLocality: l.city.split(' ').slice(1).join(' '),
        addressCountry: 'DE',
      },
      areaServed: ['DE', 'Europe', 'Worldwide'],
      knowsAbout: ['Salesforce', 'Salesforce Architecture', 'Manufacturing Cloud', 'Field Service', 'Service Cloud', 'CPQ', 'B2B Commerce'],
      founder: { '@id': `${abs(base)}#person` },
      sameAs: [site.linkedin, ...site.companyProfiles],
      inLanguage: t.lang,
    },
    {
      '@type': 'Person',
      '@id': `${abs(base)}#person`,
      name: site.person,
      jobTitle: 'Salesforce Enterprise Architect',
      url,
      image: abs(photo.src),
      worksFor: { '@id': `${abs(base)}#organization` },
      workLocation: { '@type': 'Place', name: 'Köln/Bonn' },
      knowsAbout: ['Salesforce Architecture', 'Salesforce DevOps', 'Salesforce Field Service', 'Service Cloud', 'Manufacturing Cloud', 'B2B Commerce', 'Salesforce Integration', 'Partner Governance'],
      sameAs: [site.linkedin, ...site.profiles],
    },
  ],
};
---
<script type="application/ld+json" set:html={JSON.stringify(data)} />
