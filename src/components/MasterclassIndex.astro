---
// Overview of all masterclasses (/masterclass/, /en/masterclass/), linked from the
// main menu. Side column with intro, figures and points, then one row per
// masterclass in a white box, each leading to its hub; the list comes from
// src/lib/masterclasses.ts, the texts from `masterclasses` in src/i18n.
import Page from '../layouts/Page.astro';
import Icon from './Icon.astro';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { site } from '../site';
import { homeHref } from '../lib/paths';
import { masterclassesIndex } from '../lib/masterclass';
import { getMasterclasses } from '../lib/masterclasses';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
const o = t.masterclasses;
const masterclasses = await getMasterclasses(lang);

const base = import.meta.env.BASE_URL;
const abs = (path: string) => new URL(path, Astro.site).href;
const url = abs(masterclassesIndex(lang));
const suffix = ' | FK Solution Design';
const pageTitle = o.metaTitle.length + suffix.length <= 60 ? o.metaTitle + suffix : o.metaTitle;
const ogImage = `${base}og/${lang}/masterclasses.png`;
const totalChapters = masterclasses.reduce((sum, mc) => sum + mc.chapters, 0);
// Articles are not summed: many are linked from more than one masterclass.
const stats = [
  [masterclasses.length, o.stats.masterclasses],
  [totalChapters, o.stats.chapters],
  [2, o.stats.languages],
] as const;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${url}#page`,
      url,
      name: o.title,
      description: o.metaDescription,
      inLanguage: lang,
      image: abs(ogImage),
      author: { '@type': 'Person', '@id': `${abs(base)}#person`, name: site.person, url: site.linkedin, jobTitle: 'Salesforce Enterprise Architect' },
      publisher: { '@type': 'Organization', '@id': `${abs(base)}#organization`, name: site.company },
      mainEntity: {
        '@type': 'ItemList',
        '@id': `${url}#masterclasses`,
        numberOfItems: masterclasses.length,
        itemListElement: masterclasses.map((mc, i) => ({ '@type': 'ListItem', position: i + 1, name: mc.title, url: abs(mc.href) })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'FK Solution Design', item: abs(homeHref(lang)) },
        { '@type': 'ListItem', position: 2, name: o.name, item: url },
      ],
    },
  ],
};
---
<Page layout="wide" lang={lang} title={pageTitle} description={o.metaDescription} alternates={{ en: masterclassesIndex('en'), de: masterclassesIndex('de') }} image={ogImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <section class="section blog">
    <div class="container">
      <p class="eyebrow mono">{o.eyebrow}</p>
      <h1>{o.title}</h1>
      <div class="mc-overview">
        <aside class="mc-overview-side">
          <p class="mc-overview-lead">{o.intro}</p>
          <ul class="mc-overview-stats">
            {stats.map(([n, label]) => <li><strong>{n}</strong><span>{label}</span></li>)}
          </ul>
          <ul class="mc-overview-points">
            {o.points.map((p) => <li><strong>{p.label}:</strong> {p.text}</li>)}
          </ul>
        </aside>
        <ul class="mc-overview-list">
          {masterclasses.map((mc) => (
            <li>
              <a href={mc.href}>
                <Icon name={mc.icon} class="mc-overview-icon" />
                <span class="mc-overview-body">
                  <span class="mc-overview-name mono">{mc.shortName}</span>
                  <h2 class="mc-overview-title">{mc.title}</h2>
                  <span class="mc-overview-summary">{mc.summary}</span>
                </span>
                <span class="mc-overview-meta mono">
                  {o.chapters.replace('{n}', String(mc.chapters))}
                  {mc.articles > 0 && <><br />{o.articles.replace('{n}', String(mc.articles))}</>}
                </span>
                <span class="mc-overview-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Page>
