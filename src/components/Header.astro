---
import Logo from './Logo.astro';
import type { Dict } from '../i18n/en';
import ExternalMark from './ExternalMark.astro';
import { contactHref, contactExternal } from '../site';
import { masterclassesIndex } from '../lib/masterclass';

interface Props {
  t: Dict;
  home: string;
  switchHref: string;
}
const { t, home, switchHref } = Astro.props;
const anchor = (id: string) => `${home}#${id}`;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={home} aria-label="FK Solution Design – Home">
      <Logo size={36} />
      <span class="brand-text">
        <span class="brand-name">FK Solution Design</span>
        <span class="brand-sub">Salesforce Architecture</span>
      </span>
    </a>
    <nav class="main-nav" aria-label={t.lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
      <a href={anchor('services')}>{t.nav.services}</a>
      <a href={anchor('references')}>{t.nav.references}</a>
      <a href={anchor('about')}>{t.nav.about}</a>
      <a href={`${home}blog/`}>{t.nav.blog}</a>
      <a href={masterclassesIndex(t.lang)}>{t.nav.masterclass}</a>
      <a href={anchor('contact')}>{t.nav.contact}</a>
    </nav>
    <div class="header-actions">
      <a class="lang-switch" href={switchHref} hreflang={t.lang === 'de' ? 'en' : 'de'} lang={t.lang === 'de' ? 'en' : 'de'}>
        <span class="mono">{t.lang === 'de' ? 'EN' : 'DE'}</span>
        <span class="visually-hidden">{t.nav.switchLabel}</span>
      </a>
      <a class="btn btn-small" href={contactHref(t.hero.mailSubject)} {...(contactExternal ? { target: '_blank', rel: 'noopener' } : {})}>{t.nav.cta}{contactExternal && <ExternalMark label={t.nav.newTab} />}</a>
    </div>
  </div>
</header>
