---
// One icon from the shared library in src/icons/ (catalogue: src/icons/README.md),
// inlined as SVG. `name` is the file name without `.svg`.
const icons = import.meta.glob<{ default: (props: Record<string, unknown>) => unknown }>('../icons/*.svg', { eager: true });

interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
const Svg = icons[`../icons/${name}.svg`]?.default;
if (!Svg) throw new Error(`Unknown icon "${name}", see src/icons/`);
---
<Svg class={className} aria-hidden="true" />
