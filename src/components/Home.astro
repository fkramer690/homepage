---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Blueprint from './Blueprint.astro';
import ExternalMark from './ExternalMark.astro';
import ContactForm from './ContactForm.astro';
import FloatingContact from './FloatingContact.astro';
import StructuredData from './StructuredData.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.png';
import speaking from '../assets/speaking.jpg';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { site, contactHref, contactExternal } from '../site';
import { getServices, serviceHref, servicesIndex } from '../lib/services';
import { homeHref, partnersHref } from '../lib/paths';
import { masterclassIndex } from '../lib/masterclass';
import { questions, questionPaths } from '../data/questions';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
const enHome = homeHref('en');
const deHome = homeHref('de');
const home = lang === 'de' ? deHome : enHome;
const switchHref = lang === 'de' ? enHome : deHome;
const cta = contactHref(t.hero.mailSubject);
const ctaAttrs = contactExternal ? { target: '_blank', rel: 'noopener' } : {};
const services = await getServices(lang);
const serviceLinks = new Map(services.map((s) => [s.data.order, serviceHref(s)]));
const [qOpen, qClose] = lang === 'de' ? ['„', '“'] : ['“', '”'];
---
<Base lang={lang} title={t.meta.title} description={t.meta.description} alternates={{ en: enHome, de: deHome }}>
  <StructuredData slot="head" t={t} url={new URL(home, Astro.site).href} />
  <a class="skip-link" href="#main">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>
  <Header t={t} home={home} switchHref={switchHref} />

  <main id="main">
    <section class="hero dark grid-bg">
      <Blueprint />
      <div class="container hero-inner">
        <p class="eyebrow mono">{t.hero.eyebrow}</p>
        <h1>{t.hero.title}</h1>
        <p class="hero-focus">
          {t.hero.focus.map((f, i) => (<>{i > 0 && <span class="sep" aria-hidden="true">·</span>}<span>{f}</span></>))}
        </p>
        <p class="hero-lead">{t.hero.lead}</p>
        <div class="hero-ctas">
          <a class="btn" href={cta} {...ctaAttrs}>{t.hero.ctaPrimary}{contactExternal && <ExternalMark label={t.nav.newTab} />}</a>
          <a class="btn btn-ghost" href="#references">{t.hero.ctaSecondary}</a>
        </div>
      </div>
    </section>

    <section class="proof" aria-label={lang === 'de' ? 'Kennzahlen' : 'Key figures'}>
      <div class="container">
        <ul class="proof-list">
          {t.proof.map((p) => (
            <li>
              <span class="proof-value">{p.value}</span>
              <span class="proof-label mono">{p.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="role">
      <div class="container">
        <p class="label mono">{t.role.label}</p>
        <h2>{t.role.title}</h2>
        <p class="role-problem">{t.role.problem}</p>
        <div class="two-col">
          <div>
            <h3>{t.role.situationTitle}</h3>
            <p>{t.role.situation}</p>
          </div>
          <div>
            <h3>{t.role.approachTitle}</h3>
            <p>{t.role.approach}</p>
          </div>
        </div>
        <div class="quote-row">
          <blockquote class="quote"><p>{qOpen}{t.role.quote}{qClose}</p></blockquote>
          <figure class="stage-photo">
            <Image src={speaking} alt={t.role.photoAlt} widths={[320, 614]} sizes="(max-width: 760px) 100vw, 360px" />
            <figcaption class="mono">{t.role.photoCaption}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section alt" id="services">
      <div class="container">
        <p class="label mono">{t.services.label}</p>
        <h2>{t.services.title}</h2>
        <ul class="cards">
          {t.services.items.slice(0, t.services.featured).map((s, i) => {
            const href = serviceLinks.get(i + 1);
            const inner = (
              <>
                <span class="card-index mono">{String(i + 1).padStart(2, '0')}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
                {href && <span class="card-more mono">{t.services.more} →</span>}
              </>
            );
            return href ? <li class="card card-link"><a href={href}>{inner}</a></li> : <li class="card">{inner}</li>;
          })}
          <li class="card card-wide">
            <div class="card-wide-head">
              <h3>{t.services.moreTitle}</h3>
              <span class="card-wide-links">
                <a class="card-more mono" href={servicesIndex(lang)}>{t.services.moreAll} →</a>
                <a class="card-more mono" href={partnersHref(lang)}>{t.services.morePartners} →</a>
              </span>
            </div>
            <ul class="more-rows">
              {t.services.moreItems.map((m, i) => {
                const index = String(t.services.featured + i + 1).padStart(2, '0');
                const href = serviceLinks.get(m.order);
                const inner = (
                  <>
                    <span class="more-index mono">{index}</span>
                    <span class="more-title">{t.services.items[m.order - 1].title}</span>
                    {href && <span class="more-arrow mono" aria-hidden="true">→</span>}
                    <span class="more-text">{m.text}</span>
                  </>
                );
                return <li>{href ? <a href={href}>{inner}</a> : <div>{inner}</div>}</li>;
              })}
            </ul>
          </li>
        </ul>
        <div class="focus">
          <p class="label mono">{t.services.focusLabel}</p>
          <ul class="tags">
            {t.services.focus.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="section" id="references">
      <div class="container">
        <p class="label mono">{t.references.label}</p>
        <h2>{t.references.title}</h2>
        <ul class="refs">
          {t.references.items.map((r) => (
            <li class="ref">
              <p class="ref-sector mono">{r.sector}</p>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
              <ul class="tags tags-small">
                {r.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </li>
          ))}
        </ul>
        <p class="note">{t.references.note}</p>
      </div>
    </section>

    <section class="section alt" id="approach">
      <div class="container">
        <p class="label mono">{t.approach.label}</p>
        <h2>{t.approach.title}</h2>
        <ol class="steps">
          {t.approach.steps.map((s, i) => (
            <li>
              <span class="step-no mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
        <p class="approach-more"><a class="text-link" href={`${home}${questionPaths[t.lang]}`}>{questions[t.lang].link} →</a></p>
      </div>
    </section>

    <section class="section" id="about">
      <div class="container about">
        <div class="about-main">
          <p class="label mono">{t.about.label}</p>
          <h2>{t.about.title}</h2>
          <p class="about-sub">{t.about.subtitle}</p>
          {t.about.paragraphs.map((p) => <p>{p}</p>)}
          <ul class="about-links">
            <li><a class="text-link" href={`${home}speaking/`}>{t.about.speaking} →</a></li>
            <li><a class="text-link" href={`${home}certifications/`}>{t.about.certifications} →</a></li>
            <li><a class="text-link" href={masterclassIndex(lang)}>{t.about.masterclass} →</a></li>
            <li><a class="text-link" href={site.linkedin} target="_blank" rel="noopener">{t.about.linkedin}<ExternalMark label={t.nav.externalTab} /></a></li>
          </ul>
        </div>
        <aside class="about-facts">
          <Image src={portrait} alt={t.about.portraitAlt} class="about-portrait" widths={[360, 720]} sizes="(max-width: 820px) 100vw, 360px" />
          <dl>
            {t.about.facts.map((f) => (
              <div>
                <dt class="mono">{f.label}</dt>
                <dd>{f.text}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </section>

    <section class="section alt" id="first-call">
      <div class="container">
        <p class="label mono">{t.firstCall.label}</p>
        <h2>{t.firstCall.title}</h2>
        <div class="two-col">
          <div>
            {t.firstCall.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <div>
            <h3>{t.firstCall.listTitle}</h3>
            <ul class="call-questions">
              {t.firstCall.items.map((q) => <li>{q}</li>)}
            </ul>
            <p><a class="text-link" href={`${home}${questionPaths[t.lang]}`}>{questions[t.lang].link} →</a></p>
            <a class="btn" href={cta} {...ctaAttrs}>{t.firstCall.cta}{contactExternal && <ExternalMark label={t.nav.newTab} />}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="contact dark grid-bg" id="contact">
      <Blueprint />
      <div class="container contact-inner">
        <div class="contact-intro">
          <div class="contact-head">
            <Image src={portrait} alt="" class="contact-avatar" width={128} height={128} />
            <p class="label mono">{t.contact.label}</p>
          </div>
          <h2>{t.contact.title}</h2>
          <p class="contact-text">{t.contact.text}</p>
          <a class="btn" href={cta} {...ctaAttrs}>{t.contact.cta}{contactExternal && <ExternalMark label={t.nav.newTab} />}</a>
          {contactExternal && <p class="booking-note">{t.contact.bookingNote}</p>}
          <dl class="contact-list">
            <div>
              <dt class="mono">{t.contact.linkedinLabel}</dt>
              <dd><a href={site.linkedin} target="_blank" rel="noopener">Fabian Kramer<ExternalMark label={t.nav.externalTab} /></a></dd>
            </div>
          </dl>
        </div>
        <ContactForm t={t} />
      </div>
    </section>
  </main>
  <FloatingContact t={t} />

  <Footer t={t} switchHref={switchHref} />
</Base>
