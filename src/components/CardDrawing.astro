---
// Card image on the blog overview (src/lib/card-svg.ts). Deferred cards (everything
// after the first page) get only an empty slot; the overview script fills it from the
// drawings file when the card is shown. This keeps about 470 KB of SVG out of the
// overview HTML (backlog UE5, 2026-11-12) and the DOM at a few hundred SVG elements.
import { cardSvg } from '../lib/card-svg';
import type { Topic } from '../lib/topics';

interface Props {
  translationKey: string;
  topic: Topic;
  lang: 'en' | 'de';
  deferred?: boolean;
}
const { translationKey, topic, lang, deferred = false } = Astro.props;
---
{deferred ? <span class="card-drawing-slot" data-card-drawing={translationKey}></span> : <Fragment set:html={cardSvg(translationKey, topic, lang)} />}
