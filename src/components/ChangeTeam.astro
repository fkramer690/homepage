---
// Who is behind change management in Salesforce programmes: Fabian (architecture and
// releases), Juliane Winterscheid (change management) and the joint plan, each card with
// the portraits of who is behind it. Shown on the change management service page above
// the reading grid (frontmatter section: change-management). Texts: src/data/change-management.ts.
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.png';
import julianePortrait from '../assets/partners/juliane-winterscheid-portrait.jpg';
import { homeHref, localHref } from '../lib/paths';
import { masterclassIndex } from '../lib/masterclass';
import { julianePaths } from '../data/juliane-winterscheid';
import { changeSection } from '../data/change-management';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const c = changeSection[lang].team;
const links = [`${homeHref(lang)}#about`, localHref(lang, julianePaths[lang]), masterclassIndex(lang, 'change-management')];
const people = [[portrait], [julianePortrait], [julianePortrait, portrait]];
---
<section class="service-block" aria-labelledby="team">
  <p class="label mono">{c.label}</p>
  <h2 id="team">{c.title}</h2>
  <p class="section-intro">{c.intro}</p>
  <ul class="cards pillars">
    {c.items.map((p, i) => (
      <li class="card card-link">
        <a href={links[i]}>
          <span class="card-top">
            <Icon name={p.icon} class="card-icon" />
            <span class="pillar-people">{people[i].map((img) => <Image src={img} alt="" width={44} height={44} densities={[1, 2]} />)}</span>
          </span>
          <span class="pillar-who mono">{p.who}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          <span class="card-more mono">{p.more} →</span>
        </a>
      </li>
    ))}
  </ul>
</section>
