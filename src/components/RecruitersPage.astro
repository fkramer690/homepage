---
// "Working with recruiters" in either language; content lives in src/data/recruiters.ts.
import Page from '../layouts/Page.astro';
import ExternalMark from './ExternalMark.astro';
import ContactForm from './ContactForm.astro';
import AuthorBox from './AuthorBox.astro';
import Blueprint from './Blueprint.astro';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { contactHref, contactExternal } from '../site';
import { recruiters, recruiterPaths } from '../data/recruiters';
import { homeHref, localHref, partnersHref } from '../lib/paths';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
const c = recruiters[lang];
const base = import.meta.env.BASE_URL;
const alternates = { en: localHref('en', recruiterPaths.en), de: localHref('de', recruiterPaths.de) };
const url = new URL(alternates[lang], Astro.site).href;
const abs = (path: string) => new URL(path, Astro.site).href;
const ctaAttrs = contactExternal ? { target: '_blank', rel: 'noopener' } : {};
const ogImage = `${base}og/${lang}/recruiters.png`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'FK Solution Design', item: abs(homeHref(lang)) },
    { '@type': 'ListItem', position: 2, name: t.partnerPage.title, item: abs(partnersHref(lang)) },
    { '@type': 'ListItem', position: 3, name: c.title, item: url },
  ],
};
---
<Page lang={lang} title={c.metaTitle} description={c.description} alternates={alternates} image={ogImage} hasContact>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <article class="section post questions">
    <div class="container post-inner">
      <a class="post-back mono" href={partnersHref(lang)}>← {c.back}</a>
      <p class="eyebrow mono">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      <p class="service-lead">{c.lead}</p>

      {c.sections.map((section, si) => (
        <section class="service-block" aria-labelledby={`section-${si + 1}`}>
          <h2 id={`section-${si + 1}`}>{section.title}</h2>
          {section.intro && <p class="section-intro">{section.intro}</p>}
          <ol class="question-list">
            {section.items.map(({ t: title, d }, i) => (
              <li>
                <span class="card-index mono">{String(i + 1).padStart(2, '0')}</span>
                <h3>{title}</h3>
                <p>{d}</p>
              </li>
            ))}
          </ol>
        </section>
      ))}

      <AuthorBox lang={lang} />
    </div>
  </article>
  <section class="contact dark grid-bg" id="contact">
    <Blueprint />
    <div class="container contact-inner">
      <div class="contact-intro">
        <p class="label mono">{t.contact.label}</p>
        <h2>{c.ctaTitle}</h2>
        <p class="contact-text">{c.ctaText}</p>
        <a class="btn" href={contactHref(c.formSubject)} {...ctaAttrs}>{t.nav.cta}{contactExternal && <ExternalMark label={t.nav.newTab} />}</a>
        {contactExternal && <p class="booking-note">{t.contact.bookingNote}</p>}
      </div>
      <ContactForm t={t} subject={c.formSubject} />
    </div>
  </section>
</Page>
