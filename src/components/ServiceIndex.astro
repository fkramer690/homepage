---
import Page from '../layouts/Page.astro';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { getServices, serviceHref, servicesIndex } from '../lib/services';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
const services = await getServices(lang);
---
<Page lang={lang} title={t.servicePage.metaTitle} description={t.servicePage.metaDescription} alternates={{ en: servicesIndex('en'), de: servicesIndex('de') }}>
  <section class="section blog">
    <div class="container">
      <p class="eyebrow mono">FK Solution Design</p>
      <h1>{t.servicePage.indexTitle}</h1>
      <p class="blog-intro">{t.servicePage.indexIntro}</p>
      <ul class="cards">
        {services.map((s) => (
          <li class="card card-link">
            <a href={serviceHref(s)}>
              <span class="card-index mono">{String(s.data.order).padStart(2, '0')}</span>
              <h2 class="card-title">{t.services.items[s.data.order - 1]?.title ?? s.data.title}</h2>
              <p>{s.data.description}</p>
              <span class="card-more mono">{t.services.more} →</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="partners" id="partners">
        <p class="label mono">{t.servicePage.partnersLabel}</p>
        <h2>{t.servicePage.partnersTitle}</h2>
        <p class="blog-intro">{t.servicePage.partnersIntro}</p>
        <ul class="refs">
          {t.servicePage.partners.map((p) => (
            <li class="ref">
              <p class="ref-sector mono">{p.area}</p>
              <h3>{p.name}</h3>
              <p>{p.text}</p>
              <ul class="tags tags-small">
                {p.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Page>
