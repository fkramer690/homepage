---
import Page from '../layouts/Page.astro';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import ProofBar from './ProofBar.astro';
import ApproachRing from './ApproachRing.astro';
import { getServices, serviceHref, servicesIndex } from '../lib/services';
import { homeHref, localHref } from '../lib/paths';
import ExternalMark from './ExternalMark.astro';
import { contactHref, contactExternal } from '../site';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
const services = await getServices(lang);
const ctaAttrs = contactExternal ? { target: '_blank', rel: 'noopener' } : {};
const abs = (path: string) => new URL(path, Astro.site).href;
const root = abs(import.meta.env.BASE_URL);
const url = abs(servicesIndex(lang));
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': url,
      url,
      name: t.servicePage.indexH1,
      description: t.servicePage.metaDescription,
      inLanguage: lang,
      about: { '@id': `${root}#person` },
      publisher: { '@id': `${root}#organization` },
      mainEntity: {
        '@type': 'ItemList',
        '@id': `${url}#services`,
        numberOfItems: services.length,
        itemListElement: services.map((s, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: t.services.items[s.data.order - 1]?.title ?? s.data.title,
          url: abs(serviceHref(s)),
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'FK Solution Design', item: abs(homeHref(lang)) },
        { '@type': 'ListItem', position: 2, name: t.servicePage.indexTitle, item: url },
      ],
    },
  ],
};
---
<Page layout="wide" lang={lang} title={t.servicePage.metaTitle} description={t.servicePage.metaDescription} alternates={{ en: servicesIndex('en'), de: servicesIndex('de') }}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <header class="service-hero dark grid-bg">
    <div class="container">
      <p class="eyebrow mono">{t.nav.services}</p>
      <h1>{t.servicePage.indexH1}</h1>
      <p class="service-lead">{t.servicePage.indexIntro}</p>
    </div>
  </header>
  <div class="service-index-body">
  <section class="proof">
    <div class="container">
      <ProofBar t={t} />
    </div>
  </section>
  <section class="section blog">
    <div class="container">
      <p class="service-proof-links">
        <a href={`${homeHref(lang)}#references`}>{t.hero.ctaSecondary} →</a>
        <a href={localHref(lang, 'certifications/')}>{t.servicePage.certsLink} →</a>
      </p>
      <ul class="cards">
        {services.map((s) => (
          <li class="card card-link">
            <a href={serviceHref(s)}>
              <h2 class="card-title">{t.services.items[s.data.order - 1]?.title ?? s.data.title}</h2>
              <p>{s.data.description}</p>
              <span class="card-more">{t.services.more} →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <ApproachRing lang={lang} />
  <section class="section">
    <div class="container">
      <p class="service-index-note">{t.servicePage.indexIntro2}</p>
      <div class="service-index-cta">
        <p>{t.servicePage.indexCta}</p>
        <a class="btn" href={contactHref(t.hero.mailSubject)} {...ctaAttrs}>{t.hero.ctaPrimary}{contactExternal && <ExternalMark label={t.nav.newTab} />}</a>
      </div>
    </div>
  </section>
  </div>
</Page>
