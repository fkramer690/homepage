---
// Area page of the change management pillar (/change-management/, /en/change-management/),
// linked from the main menu and the start page. Reuses the masterclass overview layout
// (side column + compact row list, docs/layouts.md). The article lists come from the
// blog collection: Juliane's articles are the basics, Fabian's articles of the category
// change-management the Salesforce practice. Texts live in src/data/change-management.ts.
import Page from '../layouts/Page.astro';
import Icon from './Icon.astro';
import Blueprint from './Blueprint.astro';
import ContactForm from './ContactForm.astro';
import ExternalMark from './ExternalMark.astro';
import { Image } from 'astro:assets';
import julianePhoto from '../assets/partners/juliane-winterscheid-portrait.jpg';
import portrait from '../assets/portrait.png';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { site, contactHref, contactExternal } from '../site';
import { homeHref, localHref } from '../lib/paths';
import { getPosts, postHref, readingMinutes } from '../lib/blog';
import { getAuthor } from '../lib/authors';
import { getServices, serviceHref } from '../lib/services';
import { getChapters, masterclassIndex } from '../lib/masterclass';
import { changeArea, changePaths } from '../data/change-management';
import { juliane, julianePaths } from '../data/juliane-winterscheid';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
const c = changeArea[lang];
const base = import.meta.env.BASE_URL;
const abs = (path: string) => new URL(path, Astro.site).href;
const alternates = { en: localHref('en', changePaths.en), de: localHref('de', changePaths.de) };
const url = abs(alternates[lang]);
const suffix = ' | FK Solution Design';
const pageTitle = c.metaTitle.length + suffix.length <= 60 ? c.metaTitle + suffix : c.metaTitle;
const ogImage = `${base}og/${lang}/change-management.png`;
const ctaAttrs = contactExternal ? { target: '_blank', rel: 'noopener' } : {};

const posts = await getPosts(lang);
const basics = posts.filter((p) => p.data.author === 'juliane');
const programmes = posts.filter((p) => p.data.author !== 'juliane' && p.data.categories.includes('change-management'));
const chapters = (await getChapters(lang, 'change-management')).length;
const service = (await getServices(lang)).find((s) => s.data.translationKey === 'service-change');

const rows = (list: typeof posts, icon: string) =>
  list.map((p) => ({ href: postHref(p), icon, name: [p.data.author, ...(p.data.coAuthor ? [p.data.coAuthor] : [])].map((id) => getAuthor(lang, id).name).join(' · '), title: p.data.title, text: p.data.description, meta: c.minutes.replace('{n}', String(readingMinutes(p))) }));
const groups = [
  { id: 'basics', ...c.groups.basics, rows: rows(basics, 'change') },
  { id: 'programmes', ...c.groups.programmes, rows: rows(programmes, 'architecture') },
  {
    id: 'offer',
    ...c.groups.offer,
    rows: [
      { href: masterclassIndex(lang, 'change-management'), icon: 'lessons', ...c.offer.masterclass, meta: t.masterclasses.chapters.replace('{n}', String(chapters)) },
      ...(service ? [{ href: serviceHref(service), icon: 'handshake', ...c.offer.service, meta: '' }] : []),
      { href: localHref(lang, julianePaths[lang]), icon: 'profile', ...c.offer.profile, meta: '' },
    ],
  },
].filter((g) => g.rows.length > 0);
const stats = [
  [basics.length, c.stats.basics],
  [programmes.length, c.stats.programmes],
  [chapters, c.stats.chapters],
] as const;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${url}#page`,
      url,
      name: c.title,
      description: c.description,
      inLanguage: lang,
      image: abs(ogImage),
      about: 'Change Management',
      author: [
        { '@type': 'Person', '@id': `${abs(localHref(lang, julianePaths[lang]))}#person`, name: 'Juliane Winterscheid' },
        { '@type': 'Person', '@id': `${abs(base)}#person`, name: site.person },
      ],
      publisher: { '@type': 'Organization', '@id': `${abs(base)}#organization`, name: site.company },
      mainEntity: {
        '@type': 'ItemList',
        '@id': `${url}#articles`,
        numberOfItems: basics.length + programmes.length,
        itemListElement: [...basics, ...programmes].map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.data.title, url: abs(postHref(p)) })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'FK Solution Design', item: abs(homeHref(lang)) },
        { '@type': 'ListItem', position: 2, name: t.nav.change, item: url },
      ],
    },
  ],
};
---
<Page layout="wide" lang={lang} title={pageTitle} description={c.description} alternates={alternates} image={ogImage} hasContact>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <section class="section blog">
    <div class="container">
      <p class="eyebrow mono">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      <div class="mc-overview">
        <aside class="mc-overview-side">
          <div class="cm-people">
            <a href={localHref(lang, julianePaths[lang])}><Image src={julianePhoto} alt={juliane[lang].portraitAlt} width={96} height={96} densities={[1, 2]} loading="eager" /></a>
            <a href={`${homeHref(lang)}#about`}><Image src={portrait} alt={site.person} width={96} height={96} densities={[1, 2]} loading="eager" /></a>
          </div>
          <p class="mc-overview-lead">{c.intro}</p>
          <ul class="mc-overview-stats">
            {stats.map(([n, label]) => <li><strong>{n}</strong><span>{label}</span></li>)}
          </ul>
          <ul class="mc-overview-points">
            {c.points.map((p) => <li><strong>{p.label}:</strong> {p.text}</li>)}
          </ul>
          <p><a class="text-link" href={localHref(lang, julianePaths[lang])}>{c.profile} →</a></p>
        </aside>
        <div class="cm-groups">
          {groups.map((g) => (
            <section class="cm-group" id={g.id} aria-labelledby={`${g.id}-title`}>
              <p class="label mono">{g.label}</p>
              <h2 id={`${g.id}-title`}>{g.title}</h2>
              <p class="cm-group-text">{g.text}</p>
              <ul class="mc-overview-list">
                {g.rows.map((r) => (
                  <li>
                    <a href={r.href}>
                      <Icon name={r.icon} class="mc-overview-icon" />
                      <span class="mc-overview-body">
                        <span class="mc-overview-name mono">{r.name}</span>
                        <h3 class="mc-overview-title">{r.title}</h3>
                        <span class="mc-overview-summary">{r.text}</span>
                      </span>
                      <span class="mc-overview-meta mono">{r.meta}</span>
                      <span class="mc-overview-arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="contact dark grid-bg" id="contact">
    <Blueprint />
    <div class="container contact-inner">
      <div class="contact-intro">
        <p class="label mono">{t.contact.label}</p>
        <h2>{c.contactTitle}</h2>
        <p class="contact-text">{c.contactText}</p>
        <a class="btn" href={contactHref(c.formSubject)} {...ctaAttrs}>{t.nav.cta}{contactExternal && <ExternalMark label={t.nav.newTab} />}</a>
        {contactExternal && <p class="booking-note">{t.contact.bookingNote}</p>}
      </div>
      <ContactForm t={t} subject={c.formSubject} />
    </div>
  </section>
</Page>
