---
// One photo of Fabian from src/data/photos.ts, as AVIF/WebP with a JPEG fallback
// in responsive widths up to the 1536px original. `sizes` must be the width the
// image is drawn at, not the box: with object-fit cover a 3:2 photo in a square
// box is drawn 1.5 times wider than the box. The browser multiplies `sizes` by
// the device pixel ratio, so a too small value makes photos blurry on Retina and
// phones. `eager` only for a photo above the fold (it then also gets fetchpriority high).
import { Picture } from 'astro:assets';
import { photos, type PhotoKey } from '../data/photos';

interface Props {
  photo: PhotoKey;
  lang: 'en' | 'de';
  sizes: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  /** Crop override (CSS object-position) where the default focus cuts off a head. */
  focus?: string;
}
const { photo, lang, sizes, widths = [480, 768, 1024, 1280, 1536], eager = false, class: className, focus } = Astro.props;
const p = photos[photo];
---
<Picture
  src={p.src}
  alt={p.alt[lang]}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  widths={widths}
  sizes={sizes}
  quality={70}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
  class={className}
  style={`object-position: ${focus ?? p.focus}`}
/>
