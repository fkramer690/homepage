---
// Key figures (t.proof) as a row: start page below the hero,
// service overview as trust evidence above the service cards.
import type { Dict } from '../i18n/en';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---
<ul class="proof-list">
  {t.proof.map((p) => (
    <li>
      <span class="proof-value">{p.value}</span>
      <span class="proof-label">{p.label}</span>
    </li>
  ))}
</ul>
