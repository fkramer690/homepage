---
import Page from '../layouts/Page.astro';
import ExternalMark from './ExternalMark.astro';
import ContactForm from './ContactForm.astro';
import PhoneLine from './PhoneLine.astro';
import AuthorBox from './AuthorBox.astro';
import ContactBrief from './ContactBrief.astro';
import ReadingGrid from './ReadingGrid.astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import ChangeTeam from './ChangeTeam.astro';
import ChangeArticles from './ChangeArticles.astro';
import { changeSection } from '../data/change-management';
import { servicePhotos } from '../data/photos';
import { getContactBrief } from '../lib/contact-briefs';
import { render } from 'astro:content';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { site, contactHref, contactExternal } from '../site';
import { postHref } from '../lib/blog';
import { type Service, servicesIndex, serviceHref, getServiceTranslation, getServiceReading } from '../lib/services';
import { categories } from '../lib/categories';
import { courses } from '../lib/courses';
import { courseTexts, masterclassIndex } from '../lib/masterclass';
import { homeHref, localHref, partnersHref } from '../lib/paths';

interface Props {
  service: Service;
}
const { service } = Astro.props;
const { lang, title, headline, description, lead, situations, deliverables, results, phases, duration, notFit, alternatives, faq, order, note, notePartner, section, masterclass, progress, reference } = service.data;
// section: change-management adds the team (Fabian and Juliane) above the reading grid and
// the change management articles instead of the related articles; "wir" there are Fabian and
// Juliane, so the deliverables heading and the author box name both (src/data/change-management.ts).
const isChange = section === 'change-management';
// Dark head with grid, then one white band with the ReadingGrid that carries the whole page
// (intro, situations, deliverables, body, phases, FAQ), so contents and booking box run along.
const t = lang === 'de' ? de : en;
// The first paragraph of the body answers "what is this service" and opens the reading
// column (src/lib/service-intro-plugin.mjs takes it out of Content); situations,
// deliverables and results follow it, then the rest of the body, the phases and the FAQ
// (order chosen by Fabian 2026-10-31, docs/service-pages.md).
// "Projekt im Fokus": one confirmed reference from the start page (references.items in src/i18n).
const caseRef = reference ? t.references.items.find((r) => r.key === reference) : undefined;
if (reference && !caseRef) throw new Error(`${service.id}: reference "${reference}" not found in references.items`);
const { Content, headings, remarkPluginFrontmatter } = await render(service);
const intro: string = remarkPluginFrontmatter.serviceIntro;
const photo = servicePhotos[service.data.translationKey];
const toc = [
  { slug: 'situations', text: t.servicePage.situations },
  { slug: 'deliverables', text: isChange ? changeSection[lang].deliverables : t.servicePage.deliverables },
  ...headings.filter((h) => h.depth === 2),
  ...(isChange ? [] : [{ slug: 'reading', text: t.servicePage.posts }]),
  { slug: 'phases', text: t.servicePage.phases },
  { slug: 'progress', text: t.servicePage.progress },
  { slug: 'fit', text: t.servicePage.fit },
  { slug: 'faq', text: t.servicePage.faq }, ...(isChange ? [{ slug: 'articles', text: changeSection[lang].articles.title }] : [])];
const translation = await getServiceTranslation(service);
// Curated reading list in the reading flow (backlog U3, docs/service-pages.md); the change
// management page lists its articles by author instead.
const posts = await getServiceReading(service);
if (!isChange && posts.length === 0) throw new Error(`${service.id}: readMore (5 to 8 articles) is required`);
const course = masterclass ? { href: masterclassIndex(lang, masterclass), name: courseTexts(lang, masterclass).name, icon: courses[masterclass].icon, chapters: courses[masterclass].chapters } : undefined;
const alternates = translation
  ? lang === 'de'
    ? { en: serviceHref(translation), de: serviceHref(service) }
    : { en: serviceHref(service), de: serviceHref(translation) }
  : undefined;
const url = new URL(serviceHref(service), Astro.site).href;
const base = import.meta.env.BASE_URL;
const abs = (path: string) => new URL(path, Astro.site).href;
const ctaAttrs = contactExternal ? { target: '_blank', rel: 'noopener' } : {};
const suffix = ' | FK Solution Design';
const pageTitle = title.length + suffix.length <= 60 ? title + suffix : title;
const ogImage = `${base}og/${lang}/services/${service.data.slug}.png`;
// The card title on the home page is the short name of the service.
const name = t.services.items[order - 1]?.title ?? title;
// The partner named in the note is linked to the partner page, followed by their LinkedIn profile.
const partner = notePartner ? t.partnerPage.partners.find((p) => p.name === notePartner) : undefined;
if (notePartner && (!partner || !note?.includes(notePartner))) {
  throw new Error(`${service.id}: notePartner "${notePartner}" must be in partnerPage.partners and appear in note`);
}
const [noteBefore, noteAfter] = partner && note ? note.split(partner.name) : [note, ''];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${url}#service`,
      name,
      serviceType: name,
      description,
      url,
      inLanguage: lang,
      image: abs(ogImage),
      provider: { '@type': 'Organization', '@id': `${abs(base)}#organization`, name: site.company },
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      inLanguage: lang,
      mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, text: q, answerCount: 1, acceptedAnswer: { '@type': 'Answer', text: a } })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'FK Solution Design', item: abs(homeHref(lang)) },
        { '@type': 'ListItem', position: 2, name: t.servicePage.indexTitle, item: abs(servicesIndex(lang)) },
        { '@type': 'ListItem', position: 3, name, item: url },
      ],
    },
  ],
};
---
<Page layout="reading" lang={lang} title={pageTitle} description={description} alternates={alternates} image={ogImage} hasContact>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <article class="post service">
    <header class="service-hero dark grid-bg">
      <div class="container">
        <a class="post-back" href={servicesIndex(lang)}>← {t.servicePage.back}</a>
        {note && (
          <p class="service-note">
            <span class="service-note-label mono">{t.servicePage.note}</span>
            <span>
              {noteBefore}{partner && <a href={partner.profile ? localHref(lang, partner.profile) : partnersHref(lang)}>{partner.name}</a>}{noteAfter}
              {partner && <> <a href={partner.linkedin} target="_blank" rel="noopener">{t.partnerPage.linkedIn}<ExternalMark label={t.nav.externalTab} /></a></>}
            </span>
          </p>
        )}
        <div class:list={['service-head', { 'has-photo': photo }]}>
          <div>
            <p class="eyebrow mono">{String(order).padStart(2, '0')} · {name}</p>
            <h1>{headline ?? title}</h1>
            <p class="service-lead">{lead}</p>
            <a class="btn" href={contactHref(name)} {...ctaAttrs}>{t.nav.cta}{contactExternal && <ExternalMark label={t.nav.newTab} />}</a>
          </div>
          {photo && <figure class="service-photo"><Photo photo={photo} lang={lang} eager sizes="(max-width: 960px) 100vw, 450px" /></figure>}
        </div>
      </div>
    </header>
    <div class="section service-band">
      <div class="container">
        <ReadingGrid t={t} headings={toc} cta={name}>
          <div class="prose service-intro"><p>{intro}</p></div>
          <section class="service-block" aria-labelledby="situations">
            <h2 id="situations">{t.servicePage.situations}</h2>
            <div class="rc-rules sit-box"><ul class="rc-rules-list">{situations.map((item) => <li>{item}</li>)}</ul></div>
          </section>
          <div class="service-columns">
            <section class="service-block" aria-labelledby="deliverables">
              <h2 id="deliverables">{isChange ? changeSection[lang].deliverables : t.servicePage.deliverables}</h2>
              <ul class="service-list">{deliverables.map((item) => <li>{item}</li>)}</ul>
            </section>
            <section class="service-block results" aria-labelledby="results">
              <h2 id="results">{t.servicePage.results}</h2>
              <ul class="service-list">{results.map((item) => <li>{item}</li>)}</ul>
            </section>
          </div>
          {caseRef && (
            <aside class="svc-case" aria-label={t.servicePage.caseLabel}>
              <p class="label mono">{t.servicePage.caseLabel}</p>
              <div class="rf-body">
                <p class="ref-sector">{caseRef.sector}</p>
                <h3>{caseRef.title}</h3>
                <dl>
                  <dt class="mono">{t.references.startLabel}</dt><dd>{caseRef.start}</dd>
                  <dt class="mono">{t.references.roleLabel}</dt><dd>{caseRef.role}</dd>
                  <dt class="mono">{t.references.resultLabel}</dt><dd>{caseRef.result}</dd>
                </dl>
                <ul class="tags tags-small">{caseRef.tags.map((tag) => <li>{tag}</li>)}</ul>
              </div>
            </aside>
          )}
          <div class="prose">
            <Content />
          </div>
          {!isChange && posts.length > 0 && (
            <section class="service-block" aria-labelledby="reading">
              <h2 id="reading">{t.servicePage.posts}</h2>
              <ol class="svc-reading">
                {posts.map((p, i) => (
                  <li>
                    <span class="svc-reading-n mono">{String(i + 1).padStart(2, '0')}</span>
                    <a href={postHref(p)}>{p.data.title}</a>
                    <span class="svc-reading-cat">{categories[p.data.categories[0]][lang]}</span>
                  </li>
                ))}
              </ol>
              {course && (
                <a class="svc-reading-course" href={course.href}>
                  <span class="svc-reading-icon"><Icon name={course.icon} /></span>
                  <span><span class="label mono">{t.servicePage.readingCourse}</span><strong>{course.name}</strong><span class="svc-reading-cat">{course.chapters} {t.servicePage.readingChapters}</span></span>
                  <span class="svc-reading-arrow" aria-hidden="true">→</span>
                </a>
              )}
            </section>
          )}
          <section class="service-block" aria-labelledby="phases">
            <h2 id="phases">{t.servicePage.phases}</h2>
            <p class="phase-duration"><strong>{t.servicePage.duration}:</strong> {duration}</p>
            <ol class="phase-flow">
              {phases.map((phase, i) => (
                <li>
                  <span class="phase-ring"><Icon name={phase.icon} /></span>
                  <span class="phase-no mono">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{phase.title}</h3>
                  <p>{phase.text}</p>
                </li>
              ))}
            </ol>
          </section>

          <section class="service-block" aria-labelledby="progress">
            <h2 id="progress">{t.servicePage.progress}</h2>
            <ol class="svc-progress">
              {progress.map((p, i) => (
                <li>
                  <span class="svc-progress-n mono">{String(i + 1).padStart(2, '0')}</span>
                  <strong>{p.measure}</strong>
                  <span>{p.how}</span>
                </li>
              ))}
            </ol>
          </section>

          <section class="service-block service-fit" aria-labelledby="fit">
            <h2 id="fit">{t.servicePage.fit}</h2>
            <h3>{t.servicePage.notFit}</h3>
            <ul class="service-list">{notFit.map((item) => <li>{item}</li>)}</ul>
            <h3>{t.servicePage.alternatives}</h3>
            <p>{alternatives}</p>
            <h3>{t.servicePage.afterCall}</h3>
            <p>{t.servicePage.afterCallText}</p>
          </section>

          <section class="post-faq" aria-labelledby="faq">
            <h2 id="faq">{t.servicePage.faq}</h2>
            {faq.map(({ q, a }) => (
              <details class="faq-item">
                <summary><h3>{q}</h3></summary>
                <p>{a}</p>
              </details>
            ))}
          </section>
          {isChange ? <AuthorBox lang={lang} coAuthor="juliane" {...changeSection[lang].authors} /> : <AuthorBox lang={lang} />}
        </ReadingGrid>
      </div>
    </div>
    {isChange && <div class="section alt service-band"><div class="container"><ChangeTeam lang={lang} /></div></div>}
    {isChange && <div class="section alt service-band"><div class="container"><ChangeArticles lang={lang} /></div></div>}
  </article>
  <section class="contact dark grid-bg" id="contact">
    <div class="container contact-inner">
      <div class="contact-intro">
        <p class="label mono">{t.contact.label}</p>
        <ContactBrief brief={getContactBrief(lang, service.data.contactBrief)} t={t} />
        <a class="btn" href={contactHref(name)} {...ctaAttrs}>{t.nav.cta}{contactExternal && <ExternalMark label={t.nav.newTab} />}</a>
        {contactExternal && <p class="booking-note">{t.contact.bookingNote}</p>}
        <PhoneLine t={t} />
      </div>
      <ContactForm t={t} subject={`${t.contact.form.subject}: ${name}`} />
    </div>
  </section>
</Page>
