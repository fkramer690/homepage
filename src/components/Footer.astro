---
import ExternalMark from './ExternalMark.astro';
import Logo from './Logo.astro';
import type { Dict } from '../i18n/en';
import { site } from '../site';
import { homeHref } from '../lib/paths';
import { masterclassIndex } from '../lib/masterclass';

interface Props {
  t: Dict;
  switchHref: string;
}
const { t, switchHref } = Astro.props;
const base = import.meta.env.BASE_URL;
const home = homeHref(t.lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Logo size={28} />
      <span>{site.company} · {t.lang === 'de' ? 'Köln' : 'Cologne'}</span>
    </div>
    <nav class="footer-nav" aria-label="Footer">
      <a href={`${home}blog/`}>{t.footer.blog}</a>
      <a href={masterclassIndex(t.lang)}>{t.nav.masterclass}</a>
      <a href={`${base}impressum/`}>{t.footer.imprint}</a>
      <a href={`${base}datenschutz/`}>{t.footer.privacy}</a>
      <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn<ExternalMark label={t.nav.externalTab} /></a>
      <a href={switchHref}>{t.nav.switchLabel}</a>
    </nav>
    <p class="footer-copy">© {year} {site.company}</p>
  </div>
</footer>
