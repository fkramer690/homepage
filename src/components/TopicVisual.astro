---
// Small topic image for blog cards: the article's topic icon on the dark
// blueprint grid of the site. Pure SVG, so it is sharp at any size and needs no file.
import { topics, type Topic } from '../lib/topics';

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;
const { icon } = topics[topic];
---
<svg class="topic-visual" viewBox="0 0 320 160" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect width="320" height="160" fill="#232325" />
  <path d="M16 0V160M32 0V160M48 0V160M64 0V160M80 0V160M96 0V160M112 0V160M128 0V160M144 0V160M160 0V160M176 0V160M192 0V160M208 0V160M224 0V160M240 0V160M256 0V160M272 0V160M288 0V160M304 0V160M0 16H320M0 32H320M0 48H320M0 64H320M0 80H320M0 96H320M0 112H320M0 128H320M0 144H320" stroke="#fff" stroke-opacity="0.05" />
  <g stroke="#1BA1E2" fill="none" stroke-width="1" opacity="0.55">
    <path d="M18 24H120M18 20v8M120 20v8" stroke-dasharray="4 4" />
    <path d="M200 140H302M200 136v8M302 136v8" stroke-dasharray="4 4" />
    <path d="M288 18h16M296 10v16" opacity="0.9" /><circle cx="296" cy="18" r="5" />
  </g>
  <g transform="translate(124 44) scale(1.125)" fill="none" stroke="#5bbdee" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
</svg>
