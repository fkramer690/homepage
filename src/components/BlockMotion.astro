---
// Builds the staircase (```stufen treppe) and pillars (```saeulen) blocks once when they
// scroll into view; the motion itself is CSS in global.css. No script or reduced motion:
// the blocks stay a still picture.
---
<script>
  const blocks = document.querySelectorAll<HTMLElement>('.cb-stairs-block, .cb-pillars');
  if (blocks.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }),
      { threshold: 0.2 },
    );
    blocks.forEach((block) => {
      block.classList.add('js-motion');
      observer.observe(block);
    });
  }
</script>
