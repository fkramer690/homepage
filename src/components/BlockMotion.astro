---
// Builds the staircase (```stufen treppe) and pillars (```saeulen) blocks once when they
// scroll into view; the motion itself is CSS in global.css. The animated explainers
// (```pipeline, ```saeulenwechsel, ```basis-addons, ```level, ```prozess) play a short sequence of
// class changes instead; the pipeline repeats while it stays in view. No script or
// reduced motion: the blocks stay a still picture.
---
<script>
  const motion = 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches;

  const blocks = document.querySelectorAll<HTMLElement>('.cb-stairs-block, .cb-pillars');
  if (blocks.length && motion) {
    const observer = new IntersectionObserver(
      (entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }),
      { threshold: 0.2 },
    );
    blocks.forEach((block) => {
      block.classList.add('js-motion');
      observer.observe(block);
    });
  }

  type Step = (at: (ms: number, fn: () => void) => void, fig: HTMLElement) => void;
  const all = (el: Element, sel: string) => [...el.querySelectorAll<HTMLElement>(sel)];
  const visible = new WeakSet<Element>();

  // Each sequence starts from cx-armed (set at load, the "empty" picture) and ends with
  // the finished picture, so the last state matches the block without script.
  const sequences: Record<string, Step> = {
    pipeline(at, fig) {
      const cards = all(fig, '.cx-pp-row .cx-card');
      const [gate, hot] = all(fig, '.cx-pp-legend li');
      const foot = fig.querySelector('.cx-foot');
      cards.forEach((c) => c.classList.remove('cx-on', 'cx-hot'));
      [gate, hot, foot].forEach((e) => e?.classList.remove('cx-in'));
      at(300, () => foot?.classList.add('cx-in'));
      cards.forEach((c, i) => at(800 + i * 850, () => c.classList.add('cx-on')));
      const passed = 800 + cards.length * 850;
      at(passed, () => gate.classList.add('cx-in'));
      const hotfix = passed + 1600;
      at(hotfix, () => cards.forEach((c) => c.classList.remove('cx-on')));
      cards.forEach((c, i) => at(hotfix + 400 + i * 380, () => c.classList.add('cx-hot')));
      const done = hotfix + 400 + cards.length * 380;
      at(done, () => hot.classList.add('cx-in'));
      at(done + 1500, () => cards.forEach((c) => { c.classList.remove('cx-hot'); c.classList.add('cx-on'); }));
      at(done + 3400, () => (visible.has(fig) ? play(fig) : fig.classList.remove('cx-started')));
    },
    // New pillar by new pillar (Fabian 2026-10-30): a pillar fills while the old terms it
    // comes from light up; old terms no pillar took and the closing notes come last.
    shift(at, fig) {
      const cards = all(fig, '.cx-new .cx-card');
      const terms = all(fig, '.cx-term');
      const light = (keys: string[]) => terms.forEach((t) => t.classList.toggle('cx-on', keys.includes(t.dataset.term ?? '')));
      let t = 700;
      cards.forEach((card) => {
        const items = all(card, '.cx-items li');
        const keys = items.flatMap((i) => (i.dataset.terms ?? '').split(' ').filter(Boolean));
        at(t, () => { cards.forEach((c) => c.classList.remove('cx-on')); card.classList.add('cx-on', 'cx-seen'); light(keys); });
        items.forEach((item, j) => at(t + 250 + j * 320, () => item.classList.add('cx-in')));
        t += 250 + items.length * 320 + 900;
      });
      at(t, () => { cards.forEach((c) => c.classList.remove('cx-on')); light(terms.filter((x) => 'rest' in x.dataset).map((x) => x.dataset.term ?? '')); fig.classList.remove('cx-armed'); });
      at(t + 1600, () => light([]));
    },
    addons(at, fig) {
      at(300, () => fig.querySelector('.cx-base')?.classList.add('cx-in'));
      all(fig, '.cx-add').forEach((a, i) => at(1200 + i * 1100, () => a.classList.add('cx-in')));
      at(1500 + all(fig, '.cx-add').length * 1100, () => fig.classList.remove('cx-armed'));
    },
    levels(at, fig) {
      const rail = fig.querySelector<HTMLElement>('.cx-rail span');
      const cards = all(fig, '.cx-lv-row .cx-card');
      let t = 400;
      cards.forEach((card, i) => {
        const ticks = all(card, '.cx-ticks li');
        at(t, () => { card.classList.add('cx-on'); if (rail) rail.style.transform = `scaleX(${(i + 1) / cards.length})`; });
        ticks.forEach((li, j) => at(t + 450 + j * 380, () => li.classList.add('cx-in')));
        at(t + 450 + ticks.length * 380 + 250, () => card.querySelector('.cx-badge')?.classList.add('cx-in'));
        t += 450 + ticks.length * 380 + 800;
      });
      at(t, () => fig.querySelector('.cx-foot')?.classList.add('cx-in'));
      at(t + 1200, () => { if (rail) rail.style.transform = ''; fig.classList.remove('cx-armed'); });
    },
    // Process in lanes: the chain lights up, then step by step through the lanes and
    // gates; the ways back and the note come last.
    process(at, fig) {
      const chain = all(fig, '.cx-chain li');
      const items = all(fig, '.cx-flow > li:not(.cx-phase)');
      chain.forEach((c, i) => at(200 + i * 250, () => c.classList.add('cx-in')));
      let t = 400 + chain.length * 250;
      items.forEach((item) => {
        at(t, () => { items.forEach((x) => x.classList.remove('cx-now')); item.classList.add('cx-on', 'cx-now'); });
        t += item.classList.contains('cx-pgate') ? 900 : 520;
      });
      at(t, () => { items.forEach((x) => x.classList.remove('cx-now')); all(fig, '.cx-loop').forEach((x) => x.classList.add('cx-in')); });
      at(t + 900, () => fig.querySelector('.cx-foot')?.classList.add('cx-in'));
      at(t + 1600, () => fig.classList.remove('cx-armed'));
    },
  };
  const kind = (fig: Element) => (['pipeline', 'shift', 'addons', 'levels', 'process'] as const).find((k) => fig.classList.contains(`cb-${k}`));

  function play(fig: HTMLElement) {
    const k = kind(fig);
    if (!k) return;
    fig.classList.add('cx-armed', 'cx-started');
    sequences[k]((ms, fn) => setTimeout(fn, ms), fig);
  }

  const explainers = document.querySelectorAll<HTMLElement>('.cb-explain');
  if (explainers.length && motion) {
    const observer = new IntersectionObserver(
      (entries) => entries.forEach((entry) => {
        const fig = entry.target as HTMLElement;
        if (!entry.isIntersecting) { visible.delete(fig); return; }
        visible.add(fig);
        if (fig.classList.contains('cx-started')) return;
        if (!fig.classList.contains('cb-pipeline')) observer.unobserve(fig);
        play(fig);
      }),
      { threshold: 0.2 },
    );
    explainers.forEach((fig) => {
      fig.classList.add('cx-armed');
      observer.observe(fig);
    });
  }
</script>
