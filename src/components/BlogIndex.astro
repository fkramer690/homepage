---
import Page from '../layouts/Page.astro';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { getPosts, postHref, readingMinutes, formatDate } from '../lib/blog';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
const base = import.meta.env.BASE_URL;
const posts = await getPosts(lang);
---
<Page lang={lang} title={t.blog.metaTitle} description={t.blog.intro} alternates={{ en: `${base}blog/`, de: `${base}de/blog/` }}>
  <section class="section blog">
    <div class="container blog-inner">
      <p class="eyebrow mono">FK Solution Design</p>
      <h1>{t.blog.title}</h1>
      <p class="blog-intro">{t.blog.intro}</p>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="post-card" href={postHref(post)}>
              <span class="post-meta mono">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
                {' · '}{readingMinutes(post)} {t.blog.readingTime}
              </span>
              <span class="post-title">{post.data.title}</span>
              <span class="post-desc">{post.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Page>
