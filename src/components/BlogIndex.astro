---
import Page from '../layouts/Page.astro';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import TopicVisual from './TopicVisual.astro';
import { Image } from 'astro:assets';
import { getPosts, postHref, readingMinutes, formatDate, cardImage } from '../lib/blog';
import { topics } from '../lib/topics';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
const base = import.meta.env.BASE_URL;
const posts = await getPosts(lang);
---
<Page lang={lang} title={t.blog.metaTitle} description={t.blog.intro} alternates={{ en: `${base}blog/`, de: `${base}de/blog/` }}>
  <section class="section blog">
    <div class="container">
      <div class="blog-inner">
        <p class="eyebrow mono">FK Solution Design</p>
        <h1>{t.blog.title}</h1>
        <p class="blog-intro">{t.blog.intro}</p>
      </div>
      <ul class="post-grid">
        {posts.map((post, i) => (
          <li class:list={['post-tile', { featured: i === 0 }]}>
            <a href={postHref(post)}>
              <span class="post-tile-media">
                {cardImage(post)
                  ? <Image class="post-tile-graphic" src={cardImage(post)!} alt="" widths={[480, 720, 1080]} sizes="(max-width: 640px) 100vw, (max-width: 980px) 50vw, 560px" />
                  : <><TopicVisual topic={post.data.topic} /><span class="post-tile-topic mono">{topics[post.data.topic][lang]}</span></>}
              </span>
              <span class="post-tile-body">
                <span class="post-meta mono">
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
                  {' · '}{readingMinutes(post)} {t.blog.readingTime}
                </span>
                <span class="post-title">{post.data.title}</span>
                <span class="post-desc">{post.data.description}</span>
                <span class="card-more mono">{t.blog.readMore} →</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Page>
