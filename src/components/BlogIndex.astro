---
import Page from '../layouts/Page.astro';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import CardDrawing from './CardDrawing.astro';
import { getPosts, postHref, readingMinutes, formatDate, blogIndex } from '../lib/blog';
import { categories, categoryIds } from '../lib/categories';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
const posts = await getPosts(lang);
// Only categories that have articles in this language get a filter button.
const filters = categoryIds
  .map((id) => ({ id, label: categories[id][lang], count: posts.filter((p) => p.data.categories.includes(id)).length }))
  .filter((f) => f.count > 0);

const abs = (path: string) => new URL(path, Astro.site).href;
const root = abs(import.meta.env.BASE_URL);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${abs(blogIndex(lang))}#blog`,
  url: abs(blogIndex(lang)),
  name: t.blog.metaTitle,
  description: t.blog.metaDescription,
  inLanguage: lang,
  author: { '@id': `${root}#person` },
  publisher: { '@id': `${root}#organization` },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    '@id': `${abs(postHref(post))}#article`,
    headline: post.data.title,
    url: abs(postHref(post)),
    datePublished: post.data.pubDate.toISOString(),
    ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  })),
};
---
<Page lang={lang} title={t.blog.metaTitle} description={t.blog.metaDescription} alternates={{ en: blogIndex('en'), de: blogIndex('de') }}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <section class="section blog">
    <div class="container">
      <div class="blog-inner">
        <p class="eyebrow mono">FK Solution Design</p>
        <h1>{t.blog.title}</h1>
        <p class="blog-intro">{t.blog.intro}</p>
      </div>
      <nav class="blog-filter" aria-label={t.blog.filterLabel}>
        <button type="button" class="filter-chip mono" data-filter="all" aria-pressed="true">
          {t.blog.filterAll} <span class="filter-count">{posts.length}</span>
        </button>
        {filters.map((f) => (
          <button type="button" class="filter-chip mono" data-filter={f.id} aria-pressed="false">
            {f.label} <span class="filter-count">{f.count}</span>
          </button>
        ))}
      </nav>
      <ul class="post-grid">
        {posts.map((post, i) => (
          <li class:list={['post-tile', { featured: i === 0 }]} data-categories={post.data.categories.join(' ')}>
            <a href={postHref(post)}>
              <span class="post-tile-media">
                <CardDrawing translationKey={post.data.translationKey} topic={post.data.topic} lang={lang} />
              </span>
              <span class="post-tile-body">
                <span class="post-meta mono">
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
                  {' · '}{readingMinutes(post)} {t.blog.readingTime}
                </span>
                <span class="post-category mono">{post.data.categories.map((c) => categories[c][lang]).join(' · ')}</span>
                <span class="post-title">{post.data.title}</span>
                <span class="post-desc">{post.data.description}</span>
                <span class="card-more mono">{t.blog.readMore} →</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Page>

<script>
  // Without JavaScript all articles stay visible. The chosen category is kept in
  // the URL hash (#devops), so a filtered overview can be linked and shared.
  const grid = document.querySelector<HTMLElement>('.post-grid');
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.filter-chip')];
  const ids = chips.map((c) => c.dataset.filter);
  function apply(id: string) {
    if (!grid) return;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === id)));
    const tiles = [...grid.querySelectorAll<HTMLElement>('.post-tile')];
    tiles.forEach((tile) => {
      tile.hidden = id !== 'all' && !(tile.dataset.categories ?? '').split(' ').includes(id);
    });
    // The newest visible article gets the wide card, in every filtered view.
    tiles.forEach((tile) => tile.classList.remove('featured'));
    tiles.find((tile) => !tile.hidden)?.classList.add('featured');
  }
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      const id = c.dataset.filter ?? 'all';
      history.replaceState(null, '', id === 'all' ? location.pathname : `#${id}`);
      apply(id);
    }),
  );
  const fromHash = location.hash.slice(1);
  if (ids.includes(fromHash)) {
    apply(fromHash);
    // On phones the buttons scroll sideways; bring the active one into view.
    chips.find((c) => c.dataset.filter === fromHash)?.scrollIntoView({ block: 'nearest', inline: 'center' });
  }
</script>
