---
import Page from '../layouts/Page.astro';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { Image } from 'astro:assets';
import CardDrawing from './CardDrawing.astro';
import Icon from './Icon.astro';
import { getPosts, postHref, readingMinutes, formatDate, blogIndex } from '../lib/blog';
import { categories, categoryIds } from '../lib/categories';
import { authorIds, getAuthor } from '../lib/authors';
import portrait from '../assets/portrait.png';
import julianePortrait from '../assets/partners/juliane-winterscheid-portrait.jpg';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
const posts = await getPosts(lang);
// An article counts for its author and its co-author.
const authorsOf = (post: (typeof posts)[number]) => [post.data.author, ...(post.data.coAuthor ? [post.data.coAuthor] : [])];
const authorImg = { fabian: portrait, juliane: julianePortrait };
// Two filters that combine: author and topic. Only categories that have articles
// in this language get an entry.
const authorFilters = authorIds.map((id) => ({
  id,
  name: getAuthor(lang, id).name,
  focus: t.blog.authorFocus[id],
  img: authorImg[id],
  count: posts.filter((p) => authorsOf(p).includes(id)).length,
}));
const topicFilters = categoryIds
  .map((id) => ({ id, label: categories[id][lang], icon: categories[id].icon, count: posts.filter((p) => p.data.categories.includes(id)).length }))
  .filter((f) => f.count > 0);

// What the search bar looks through: title, description, tags and topic names.
const searchText = (post: (typeof posts)[number]) =>
  [post.data.title, post.data.description, ...post.data.tags, ...post.data.categories.map((c) => categories[c][lang])].join(' ').toLowerCase();

const abs = (path: string) => new URL(path, Astro.site).href;
const root = abs(import.meta.env.BASE_URL);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${abs(blogIndex(lang))}#blog`,
  url: abs(blogIndex(lang)),
  name: t.blog.metaTitle,
  description: t.blog.metaDescription,
  inLanguage: lang,
  author: { '@id': `${root}#person` },
  publisher: { '@id': `${root}#organization` },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    '@id': `${abs(postHref(post))}#article`,
    headline: post.data.title,
    url: abs(postHref(post)),
    datePublished: post.data.pubDate.toISOString(),
    ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  })),
};
---
<Page layout="wide" lang={lang} title={t.blog.metaTitle} description={t.blog.metaDescription} alternates={{ en: blogIndex('en'), de: blogIndex('de') }}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <section class="section blog">
    <div class="container">
      <div class="blog-inner">
        <p class="eyebrow mono">FK Solution Design</p>
        <h1>{t.blog.title}</h1>
        <p class="blog-intro">{t.blog.intro}</p>
      </div>
      <div class="blog-layout">
        <aside class="blog-filter" aria-label={t.blog.filterLabel}>
          <details class="blog-filter-box" open>
            <summary class="blog-filter-toggle"><Icon name="sliders" class="blog-filter-toggle-icon" />{t.blog.filterButton} <span class="blog-filter-active" data-active></span></summary>
            <p class="blog-filter-head mono">{t.blog.filterAuthor}</p>
            <ul class="blog-filter-list">
              <li><button type="button" class="filter-item" data-author="all" aria-pressed="true"><span class="filter-media filter-all"><Icon name="team" /></span><span class="filter-label">{t.blog.filterAuthorAll}</span><span class="filter-count">{posts.length}</span></button></li>
              {authorFilters.map((a) => (
                <li><button type="button" class="filter-item" data-author={a.id} aria-pressed="false"><Image src={a.img} alt="" width={32} height={32} densities={[1, 2]} class="filter-media filter-avatar" /><span class="filter-label">{a.name}<small>{a.focus}</small></span><span class="filter-count" data-count-author={a.id}>{a.count}</span></button></li>
              ))}
            </ul>
            <p class="blog-filter-head mono">{t.blog.filterTopic}</p>
            <ul class="blog-filter-list">
              <li><button type="button" class="filter-item" data-topic="all" aria-pressed="true"><span class="filter-media"><Icon name="compass" /></span><span class="filter-label">{t.blog.filterTopicAll}</span></button></li>
              {topicFilters.map((f) => (
                <li><button type="button" class="filter-item" data-topic={f.id} aria-pressed="false"><span class="filter-media"><Icon name={f.icon} /></span><span class="filter-label">{f.label}</span><span class="filter-count" data-count-topic={f.id}>{f.count}</span></button></li>
              ))}
            </ul>
            <p class="blog-filter-result" aria-live="polite"><span data-result>{posts.length}</span> {t.blog.filterResult} <button type="button" class="blog-filter-reset" data-reset hidden>× {t.blog.filterReset}</button></p>
          </details>
        </aside>
        <div class="blog-main">
          <search class="blog-search">
            <label class="blog-search-field">
              <Icon name="search" class="blog-search-icon" />
              <input type="search" data-search-input placeholder={t.blog.searchPlaceholder} aria-label={t.blog.searchLabel} autocomplete="off" />
              <kbd class="mono">/</kbd>
            </label>
            <p class="blog-search-popular"><span>{t.blog.searchPopular}:</span>{t.blog.searchPopularTerms.map((term) => <button type="button" class="blog-search-chip" data-search-term={term}>{term}</button>)}</p>
            <p class="blog-search-status" aria-live="polite" data-search-status hidden><span><strong data-search-count></strong> {t.blog.searchHits} {lang === 'de' ? '„' : '“'}<span data-search-query></span>{lang === 'de' ? '“' : '”'}</span> <button type="button" class="blog-filter-reset" data-search-clear>× {t.blog.searchClear}</button></p>
          </search>
        <ul class="post-grid" data-more-text={t.blog.loadMoreCount}>
          {posts.map((post, i) => (
            <li class:list={['post-tile', { featured: i === 0 }]} data-categories={post.data.categories.join(' ')} data-authors={authorsOf(post).join(' ')} data-search={searchText(post)}>
              <a href={postHref(post)}>
                <span class="post-tile-media">
                  <CardDrawing translationKey={post.data.translationKey} topic={post.data.topic} lang={lang} />
                </span>
                <span class="post-tile-body">
                  <span class="post-meta">
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
                    {' · '}{readingMinutes(post)} {t.blog.readingTime}
                  </span>
                  <span class="post-category mono">{categories[post.data.categories[0]][lang]}</span>
                  <span class="post-title">{post.data.title}</span>
                  <span class="post-desc">{post.data.description}</span>
                  <span class="post-byline"><span class="post-byline-faces">{authorsOf(post).map((a) => <Image src={authorImg[a]} alt="" width={28} height={28} densities={[1, 2]} />)}</span>{authorsOf(post).map((a) => getAuthor(lang, a).name).join(' & ')}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="blog-search-none" data-search-none hidden>{t.blog.searchNone}</p>
        <div class="blog-more" data-more hidden>
          <p class="blog-more-count" aria-live="polite" data-more-count></p>
          <button type="button" class="btn btn-ghost blog-more-button" data-more-button>{t.blog.loadMore}</button>
        </div>
        </div>
      </div>
    </div>
  </section>
</Page>

<script>
  // Without JavaScript all articles stay visible. Search, author and topic filter
  // combine. The filters are kept in the URL hash (#juliane, #devops or
  // #juliane+change-management), the search in ?q=, so every view can be shared.
  // The overview shows the first PAGE matching articles; "Load more" adds the next
  // PAGE. Filter and search always look through all articles.
  const PAGE = 24;
  const box = document.querySelector<HTMLElement>('.blog-filter');
  const grid = document.querySelector<HTMLElement>('.post-grid');
  if (box && grid) {
    const tiles = [...grid.querySelectorAll<HTMLElement>('.post-tile')];
    const authors = [...box.querySelectorAll<HTMLButtonElement>('[data-author]')];
    const topics = [...box.querySelectorAll<HTMLButtonElement>('[data-topic]')];
    const input = document.querySelector<HTMLInputElement>('[data-search-input]')!;
    const status = document.querySelector<HTMLElement>('[data-search-status]')!;
    const none = document.querySelector<HTMLElement>('[data-search-none]')!;
    const more = document.querySelector<HTMLElement>('[data-more]')!;
    const moreCount = more.querySelector<HTMLElement>('[data-more-count]')!;
    const moreText = grid.dataset.moreText ?? '';
    const state = { author: 'all', topic: 'all', q: '', limit: PAGE };
    const has = (tile: HTMLElement, key: 'authors' | 'categories', id: string) =>
      id === 'all' || (tile.dataset[key] ?? '').split(' ').includes(id);
    // Every word must appear (in any order); one-letter words are ignored.
    const words = () => state.q.toLowerCase().split(/\s+/).filter((w) => w.length > 1);
    const found = (tile: HTMLElement) => words().every((w) => (tile.dataset.search ?? '').includes(w));
    const count = (author: string, topic: string) =>
      tiles.filter((tile) => has(tile, 'authors', author) && has(tile, 'categories', topic) && found(tile)).length;

    // Hits are marked in title and description; the original text is kept to undo it.
    const texts = new Map<HTMLElement, string>();
    tiles.forEach((tile) => tile.querySelectorAll<HTMLElement>('.post-title, .post-desc').forEach((el) => texts.set(el, el.textContent ?? '')));
    const escape = (text: string) => text.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
    function highlight() {
      const ws = words();
      const pattern = ws.length ? new RegExp(`(${ws.map((w) => w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi') : null;
      texts.forEach((text, el) => { el.innerHTML = pattern ? escape(text).replace(pattern, '<mark>$1</mark>') : escape(text); });
    }

    function apply() {
      authors.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.author === state.author)));
      topics.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.topic === state.topic)));
      const searching = words().length > 0;
      // The wide first card takes two places, so one more card fills the last row.
      const limit = state.limit + (searching ? 0 : 1);
      let matches = 0;
      tiles.forEach((tile) => {
        const match = has(tile, 'authors', state.author) && has(tile, 'categories', state.topic) && found(tile);
        if (match) matches++;
        tile.hidden = !match || matches > limit;
        tile.classList.remove('featured');
      });
      more.hidden = matches <= limit;
      moreCount.textContent = moreText.replace('{shown}', String(Math.min(matches, limit))).replace('{total}', String(matches));
      highlight();
      // The newest visible article gets the wide card in every filtered view; search
      // results stay in plain order.
      if (!searching) tiles.find((tile) => !tile.hidden)?.classList.add('featured');
      // Each list counts within the other filter's choice; empty topics are greyed out.
      box!.querySelectorAll<HTMLElement>('[data-count-topic]').forEach((c) => {
        const n = count(state.author, c.dataset.countTopic!);
        c.textContent = String(n);
        c.closest('button')?.classList.toggle('is-empty', n === 0);
      });
      box!.querySelectorAll<HTMLElement>('[data-count-author]').forEach((c) => {
        const n = count(c.dataset.countAuthor!, state.topic);
        c.textContent = String(n);
        c.closest('button')?.classList.toggle('is-empty', n === 0);
      });
      const shown = count(state.author, state.topic);
      const active = [state.author, state.topic].filter((id) => id !== 'all');
      box!.querySelector('[data-result]')!.textContent = String(shown);
      box!.querySelector<HTMLElement>('[data-reset]')!.hidden = active.length === 0 && !searching;
      box!.querySelector('[data-active]')!.textContent = active.length || searching ? String(shown) : '';
      status.hidden = !searching;
      status.querySelector('[data-search-count]')!.textContent = String(shown);
      status.querySelector('[data-search-query]')!.textContent = state.q.trim();
      none.hidden = shown > 0;
      const query = searching ? `?q=${encodeURIComponent(state.q.trim())}` : '';
      history.replaceState(null, '', `${location.pathname}${query}${active.length ? `#${active.join('+')}` : ''}`);
    }

    // Every new filter or search starts again with the first PAGE hits.
    authors.forEach((b) => b.addEventListener('click', () => { state.author = b.dataset.author ?? 'all'; state.limit = PAGE; apply(); }));
    topics.forEach((b) => b.addEventListener('click', () => { state.topic = b.dataset.topic ?? 'all'; state.limit = PAGE; apply(); }));
    const search = (q: string) => { state.q = q; input.value = q; state.limit = PAGE; apply(); };
    input.addEventListener('input', () => { state.q = input.value; state.limit = PAGE; apply(); });
    more.querySelector('[data-more-button]')?.addEventListener('click', () => {
      // Focus moves to the first new article, so keyboard users continue there.
      const first = tiles.filter((tile) => tile.hidden && has(tile, 'authors', state.author) && has(tile, 'categories', state.topic) && found(tile))[0];
      state.limit += PAGE;
      apply();
      first?.querySelector('a')?.focus({ preventScroll: true });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-search-term]').forEach((b) => b.addEventListener('click', () => search(b.dataset.searchTerm ?? '')));
    status.querySelector('[data-search-clear]')?.addEventListener('click', () => { search(''); input.focus(); });
    box.querySelector('[data-reset]')?.addEventListener('click', () => { state.author = 'all'; state.topic = 'all'; search(''); });
    // "/" jumps into the search field, as on many documentation sites.
    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      if (e.key === '/' && !e.metaKey && !e.ctrlKey && !target.closest('input, textarea, select, [contenteditable]')) { e.preventDefault(); input.focus(); }
    });

    const authorIds = authors.map((b) => b.dataset.author);
    const topicIds = topics.map((b) => b.dataset.topic);
    for (const part of location.hash.slice(1).split('+')) {
      if (authorIds.includes(part)) state.author = part;
      else if (topicIds.includes(part)) state.topic = part;
    }
    // On phones the filter starts folded, so the articles come first.
    if (window.matchMedia('(max-width: 960px)').matches) box.querySelector('details')?.removeAttribute('open');
    state.q = new URLSearchParams(location.search).get('q') ?? '';
    input.value = state.q;
    apply();
  }
</script>
