---
// Author box below every blog article. Rendered by BlogPost.astro for all
// articles, so it looks the same everywhere; never add one in Markdown.
// `author: juliane` shows Juliane Winterscheid with a link to her profile page.
import { Image } from 'astro:assets';
import ExternalMark from './ExternalMark.astro';
import portrait from '../assets/portrait.png';
import julianePortrait from '../assets/partners/juliane-winterscheid-portrait.jpg';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { homeHref, localHref } from '../lib/paths';
import { type AuthorId, getAuthor } from '../lib/authors';
import { juliane } from '../data/juliane-winterscheid';

interface Props {
  lang: 'en' | 'de';
  author?: AuthorId;
}
const { lang, author = 'fabian' } = Astro.props;
const t = lang === 'de' ? de : en;
const a = getAuthor(lang, author);
const box =
  author === 'juliane'
    ? { label: juliane[lang].author.label, img: julianePortrait, role: juliane[lang].box.role, bio: juliane[lang].author.bio, more: juliane[lang].author.more, moreHref: localHref(lang, a.profile!) }
    : { label: t.blog.authorLabel, img: portrait, role: t.blog.authorRole, bio: t.blog.authorBio, more: t.blog.authorMore, moreHref: `${homeHref(lang)}#about` };
---
<aside class="post-author" aria-label={box.label}>
  <Image src={box.img} alt={a.name} width={112} height={112} densities={[1, 2]} class="post-author-img" />
  <div class="post-author-body">
    <p class="label mono">{box.label}</p>
    <p class="post-author-name">{a.name}</p>
    <p class="post-author-role mono">{box.role}</p>
    <p class="post-author-bio">{box.bio}</p>
    <div class="post-author-links">
      <a class="btn btn-small" href={a.linkedin} target="_blank" rel="noopener">{t.blog.authorLinkedIn}<ExternalMark label={t.nav.externalTab} /></a>
      <a class="post-author-more" href={box.moreHref}>{box.more} →</a>
    </div>
  </div>
</aside>
