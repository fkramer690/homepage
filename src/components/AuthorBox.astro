---
// Author box below every blog article. Rendered by BlogPost.astro for all
// articles, so it looks the same everywhere; never add one in Markdown.
import { Image } from 'astro:assets';
import ExternalMark from './ExternalMark.astro';
import portrait from '../assets/portrait.png';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { site } from '../site';
import { homeHref } from '../lib/paths';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
---
<aside class="post-author" aria-label={t.blog.authorLabel}>
  <Image src={portrait} alt="Fabian Kramer" width={112} height={112} densities={[1, 2]} class="post-author-img" />
  <div class="post-author-body">
    <p class="label mono">{t.blog.authorLabel}</p>
    <p class="post-author-name">{site.person}</p>
    <p class="post-author-role mono">{t.blog.authorRole}</p>
    <p class="post-author-bio">{t.blog.authorBio}</p>
    <div class="post-author-links">
      <a class="btn btn-small" href={site.linkedin} target="_blank" rel="noopener">{t.blog.authorLinkedIn}<ExternalMark label={t.nav.externalTab} /></a>
      <a class="post-author-more" href={`${homeHref(lang)}#about`}>{t.blog.authorMore} →</a>
    </div>
  </div>
</aside>
