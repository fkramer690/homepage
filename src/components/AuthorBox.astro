---
// Author box below every blog article. Rendered by BlogPost.astro for all
// articles, so it looks the same everywhere; never add one in Markdown.
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.png';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { site } from '../site';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
const base = import.meta.env.BASE_URL;
---
<aside class="post-author" aria-label={t.blog.authorLabel}>
  <Image src={portrait} alt="" width={112} height={112} densities={[1, 2]} class="post-author-img" />
  <div class="post-author-body">
    <p class="label mono">{t.blog.authorLabel}</p>
    <p class="post-author-name">{site.person}</p>
    <p class="post-author-role mono">{t.blog.authorRole}</p>
    <p class="post-author-bio">{t.blog.authorBio}</p>
    <div class="post-author-links">
      <a class="btn btn-small" href={site.linkedin} rel="noopener">{t.blog.authorLinkedIn}</a>
      <a class="post-author-more" href={`${lang === 'de' ? `${base}de/` : base}#about`}>{t.blog.authorMore} →</a>
    </div>
  </div>
</aside>
