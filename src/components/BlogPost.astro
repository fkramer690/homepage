---
import Page from '../layouts/Page.astro';
import ExternalMark from './ExternalMark.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.png';
import { render } from 'astro:content';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { site, contactHref, contactExternal } from '../site';
import { type Post, blogIndex, postHref, getTranslation, readingMinutes, formatDate } from '../lib/blog';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { lang, title, description, pubDate, updatedDate } = post.data;
const t = lang === 'de' ? de : en;
const { Content } = await render(post);
const translation = await getTranslation(post);
const alternates = translation
  ? lang === 'de'
    ? { en: postHref(translation), de: postHref(post) }
    : { en: postHref(post), de: postHref(translation) }
  : undefined;
const url = new URL(postHref(post), Astro.site).href;
const base = import.meta.env.BASE_URL;
const abs = (path: string) => new URL(path, Astro.site).href;
const ctaAttrs = contactExternal ? { target: '_blank', rel: 'noopener' } : {};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: lang,
  mainEntityOfPage: url,
  image: abs(`${base}og-image.png`),
  keywords: post.data.tags.join(', '),
  author: { '@type': 'Person', '@id': `${abs(base)}#person`, name: site.person, url: site.linkedin },
  publisher: { '@id': `${abs(base)}#organization` },
};
---
<Page lang={lang} title={`${title} | FK Solution Design`} description={description} alternates={alternates}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="section post">
    <div class="container post-inner">
      <a class="post-back mono" href={blogIndex(lang)}>← {t.blog.back}</a>
      <h1>{title}</h1>
      <p class="post-meta mono">
        {site.person} · {t.blog.published} <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
        {updatedDate && <> · {t.blog.updated} <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, lang)}</time></>}
        {' · '}{readingMinutes(post)} {t.blog.readingTime}
      </p>
      <div class="prose">
        <Content />
      </div>
      <aside class="post-author">
        <Image src={portrait} alt={site.person} width={72} height={72} densities={[1, 2]} class="post-author-img" />
        <div>
          <p class="post-author-name">{site.person}</p>
          <p>{t.blog.authorBio} <a href={site.linkedin} rel="noopener">LinkedIn</a></p>
        </div>
      </aside>
      <div class="post-cta">
        <h2>{t.blog.ctaTitle}</h2>
        <p>{t.blog.ctaText}</p>
        <a class="btn" href={contactHref(title)} {...ctaAttrs}>{t.nav.cta}{contactExternal && <ExternalMark label={t.nav.newTab} />}</a>
      </div>
    </div>
  </article>
</Page>
