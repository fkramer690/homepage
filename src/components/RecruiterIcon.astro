---
// Line icons of the recruiter page: grey strokes, one cyan accent (same style as StepIcon).
import type { RecruiterIconName } from '../data/recruiters';

interface Props {
  name: RecruiterIconName;
}
const { name } = Astro.props;
const g = '#8a8a8e';
const c = '#1BA1E2';
---
<svg class="rc-icon" viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === 'clock' && (<><circle cx="24" cy="24" r="16" stroke={g} /><path d="M24 14v10l7 5" stroke={c} stroke-width="2.2" /></>)}
  {name === 'scale' && (<><path d="M24 9v30M15 39h18M10 15h28" stroke={g} /><path d="M10 15l-5 11h10zM38 15l-5 11h10z" stroke={c} /></>)}
  {name === 'profile' && (<><rect x="10" y="7" width="28" height="34" rx="3" stroke={g} /><circle cx="24" cy="19" r="5" stroke={c} /><path d="M16 33c1.5-4 4.5-6 8-6s6.5 2 8 6" stroke={c} /></>)}
  {name === 'calendar' && (<><rect x="7" y="11" width="34" height="29" rx="3" stroke={g} /><path d="M7 19h34M16 7v8M32 7v8" stroke={g} /><path d="M18 29l4 4 8-8" stroke={c} stroke-width="2.2" /></>)}
  {name === 'handshake' && (<><path d="M4 20l8-6 8 3M44 20l-8-6-8 3" stroke={g} /><path d="M12 28l8 8c1.5 1.5 3.5 1.5 5 0l9-9c1.5-1.5 1.5-3.5 0-5l-6-5-8 6c-1.5 1-3.5.5-4-1" stroke={c} /></>)}
  {name === 'building' && (<><path d="M9 41V13l14-6v34M23 17h16v24M5 41h38" stroke={g} /><path d="M14 19h4M14 26h4M14 33h4M29 25h4M29 32h4" stroke={c} /></>)}
  {name === 'compass' && (<><circle cx="24" cy="24" r="16" stroke={g} /><path d="M30 18l-3.5 9.5L18 30l3.5-9.5z" stroke={c} /></>)}
  {name === 'sliders' && (<><path d="M8 14h32M8 24h32M8 34h32" stroke={g} /><circle cx="17" cy="14" r="3.5" fill="#fff" stroke={c} /><circle cx="31" cy="24" r="3.5" fill="#fff" stroke={c} /><circle cx="22" cy="34" r="3.5" fill="#fff" stroke={c} /></>)}
  {name === 'budget' && (<><rect x="6" y="13" width="36" height="24" rx="3" stroke={g} /><path d="M29 19.5a7 7 0 1 0 0 11M18 23h9M18 27h9" stroke={c} /></>)}
  {name === 'feedback' && (<><path d="M8 10h32v22H22l-8 7v-7H8z" stroke={g} /><path d="M16 21h16M16 26h10" stroke={c} /></>)}
  {name === 'mail' && (<><rect x="6" y="11" width="36" height="26" rx="3" stroke={g} /><path d="M7 13l17 13 17-13" stroke={c} /></>)}
  {name === 'check' && (<><circle cx="24" cy="24" r="16" stroke={g} /><path d="M16 24l6 6 11-12" stroke={c} stroke-width="2.4" /></>)}
  {name === 'interview' && (<><circle cx="15" cy="17" r="5" stroke={g} /><path d="M6 37c0-6 4-10 9-10s9 4 9 10" stroke={g} /><circle cx="33" cy="17" r="5" stroke={c} /><path d="M24 37c0-6 4-10 9-10s9 4 9 10" stroke={c} /></>)}
  {name === 'contract' && (<><path d="M12 6h18l8 8v28H12z" stroke={g} /><path d="M30 6v8h8M17 22h14M17 28h14" stroke={g} /><path d="M17 36c2-3 4-3 5 0s3 3 5 0 3-2 5 0" stroke={c} /></>)}
</svg>
