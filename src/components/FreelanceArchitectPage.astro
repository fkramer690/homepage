---
// "Freelance Salesforce Architect" in either language; content lives in src/data/freelance-architect.ts.
import Page from '../layouts/Page.astro';
import ExternalMark from './ExternalMark.astro';
import ContactForm from './ContactForm.astro';
import Blueprint from './Blueprint.astro';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.png';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { contactHref, contactExternal } from '../site';
import { freelanceArchitect, freelanceArchitectPaths } from '../data/freelance-architect';
import { homeHref, localHref } from '../lib/paths';

interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
const t = lang === 'de' ? de : en;
const c = freelanceArchitect[lang];
const base = import.meta.env.BASE_URL;
const alternates = { en: localHref('en', freelanceArchitectPaths.en), de: localHref('de', freelanceArchitectPaths.de) };
const url = new URL(alternates[lang], Astro.site).href;
const abs = (path: string) => new URL(path, Astro.site).href;
const ctaAttrs = contactExternal ? { target: '_blank', rel: 'noopener' } : {};
const ogImage = `${base}og/${lang}/freelance-architect.png`;
const href = (path: string) => localHref(lang, path);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      inLanguage: lang,
      mainEntity: c.faq.map(({ q, a }) => ({ '@type': 'Question', name: q, text: q, answerCount: 1, acceptedAnswer: { '@type': 'Answer', text: a } })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'FK Solution Design', item: abs(homeHref(lang)) },
        { '@type': 'ListItem', position: 2, name: c.title, item: url },
      ],
    },
  ],
};
---
<Page layout="wide" lang={lang} title={c.metaTitle} description={c.description} alternates={alternates} image={ogImage} hasContact>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <section class="hero dark grid-bg rc-hero">
    <Blueprint />
    <div class="container hero-inner rc-hero-inner">
      <div>
        <p class="eyebrow mono">{c.eyebrow}</p>
        <h1>{c.title}</h1>
        <p class="hero-lead">{c.lead}</p>
        <ul class="rc-promises mono">{c.promises.map((p) => <li>{p}</li>)}</ul>
        <div class="hero-ctas">
          <a class="btn" href="#contact">{c.ctaPrimary}</a>
          <a class="btn btn-ghost" href="#situations">{c.ctaSecondary}</a>
        </div>
      </div>
      <figure class="rc-portrait">
        <Image src={portrait} alt={c.portraitAlt} widths={[320, 640]} sizes="(max-width: 880px) 220px, 320px" />
        <figcaption class="mono">Fabian Kramer · Salesforce Enterprise Architect</figcaption>
      </figure>
    </div>
  </section>

  <section class="proof" aria-label={lang === 'de' ? 'Kennzahlen' : 'Key figures'}>
    <div class="container">
      <ul class="proof-list rc-facts">
        {c.facts.map((f) => (
          <li>
            <span class="proof-value">{f.value}</span>
            <span class="proof-label mono">{f.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="situations">
    <div class="container">
      <p class="label mono">{c.situations.label}</p>
      <h2>{c.situations.title}</h2>
      <p class="section-intro">{c.situations.intro}</p>
      <ul class="fa-cards">
        {c.situations.cards.map((card) => (
          <li>
            <Icon name={card.icon} class="rc-icon" />
            <h3>{card.t}</h3>
            <p>{card.d}</p>
            <a class="fa-link mono" href={href(card.link)}>{card.linkText} →</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section alt" id="compare">
    <div class="container">
      <p class="label mono">{c.compare.label}</p>
      <h2>{c.compare.title}</h2>
      <p class="section-intro">{c.compare.intro}</p>
      <div class="fa-table-wrap">
        <table class="fa-table">
          <thead>
            <tr><th scope="col"><span class="visually-hidden">{c.compare.label}</span></th><th scope="col" class="fa-me">{c.compare.colMe}</th><th scope="col">{c.compare.colPartner}</th></tr>
          </thead>
          <tbody>
            {c.compare.rows.map((r) => (
              <tr><th scope="row" class="mono">{r.k}</th><td class="fa-me">{r.me}</td><td>{r.partner}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fa-more">{c.compare.more} <a href={href(c.compare.moreLink)}>{c.compare.moreText}</a></p>
    </div>
  </section>

  <section class="section" id="results">
    <div class="container">
      <p class="label mono">{c.deliverables.label}</p>
      <h2>{c.deliverables.title}</h2>
      <ul class="fa-results">
        {c.deliverables.items.map((p) => (
          <li><Icon name={p.icon} class="rc-icon" /><div><strong>{p.t}</strong><span>{p.d}</span></div></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section dark grid-bg fa-practice">
    <Blueprint />
    <div class="container">
      <p class="label mono">{c.practice.label}</p>
      <h2>{c.practice.title}</h2>
      <ul class="fa-practice-facts">
        {c.practice.facts.map((f) => (
          <li><span class="proof-value">{f.value}</span><span class="proof-label mono">{f.label}</span></li>
        ))}
      </ul>
      <p class="fa-practice-text">{c.practice.text}</p>
    </div>
  </section>

  <section class="section" id="process">
    <div class="container">
      <p class="label mono">{c.process.label}</p>
      <h2>{c.process.title}</h2>
      <ol class="steps fa-steps">
        {c.process.steps.map((s, i) => (
          <li>
            <Icon name={s.icon} class="rc-icon" />
            <span class="step-no mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
      <div class="rc-terms">
        <p class="label mono">{c.process.termsLabel}</p>
        <div class="rc-terms-grid fa-terms-grid">
          {c.process.terms.map((term) => (
            <div>
              <h3>{term.t}</h3>
              <p>{term.d}{term.link && <> <a href={href(term.link)}>{term.linkText}</a></>}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="faq">
    <div class="container">
      <div class="fa-faq">
        <h2 id="faq">{c.faqTitle}</h2>
        {c.faq.map(({ q, a }) => (
          <details class="faq-item">
            <summary><h3>{q}</h3></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="contact dark grid-bg" id="contact">
    <Blueprint />
    <div class="container contact-inner">
      <div class="contact-intro">
        <p class="label mono">{t.contact.label}</p>
        <h2>{c.ctaTitle}</h2>
        <p class="contact-text">{c.ctaText}</p>
        <a class="btn" href={contactHref(c.formSubject)} {...ctaAttrs}>{t.nav.cta}{contactExternal && <ExternalMark label={t.nav.newTab} />}</a>
        {contactExternal && <p class="booking-note">{t.contact.bookingNote}</p>}
      </div>
      <ContactForm t={t} subject={c.formSubject} />
    </div>
  </section>
</Page>
