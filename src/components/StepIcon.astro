---
// Line icon for one of the four approach steps on the start page
// (analyse, design, steer, implement): grey strokes, one cyan accent.
interface Props {
  index: number;
}
const { index } = Astro.props;
---
<svg class="step-icon" viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke-width="1.6">
  {index === 0 && (
    <>
      <circle cx="21" cy="21" r="11" stroke="#5a5a5e" />
      <path d="M15 21h12M21 15v12" stroke="#e3e5e7" stroke-width="1.4" />
      <path d="M29 29l9 9" stroke="#1BA1E2" stroke-width="2" stroke-linecap="round" />
    </>
  )}
  {index === 1 && (
    <>
      <rect x="7" y="9" width="34" height="30" rx="3" stroke="#5a5a5e" />
      <path d="M7 19h34M19 19v20" stroke="#5a5a5e" stroke-width="1.4" />
      <rect x="24" y="25" width="11" height="8" rx="1.5" stroke="#1BA1E2" stroke-width="1.8" />
    </>
  )}
  {index === 2 && (
    <>
      <path d="M6 24h12M30 24h12" stroke="#5a5a5e" />
      <rect x="18" y="14" width="12" height="20" rx="2" stroke="#1BA1E2" stroke-width="1.8" />
      <path d="M21 24l2 2 4-4" stroke="#1BA1E2" stroke-width="1.8" />
    </>
  )}
  {index === 3 && (
    <>
      <circle cx="24" cy="24" r="15" stroke="#5a5a5e" />
      <path d="M9 24h30M24 9c-6 7-6 23 0 30M24 9c6 7 6 23 0 30" stroke="#5a5a5e" stroke-width="1.2" />
      <circle cx="31" cy="17" r="3" fill="#1BA1E2" stroke="none" />
    </>
  )}
</svg>
