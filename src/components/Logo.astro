---
// Tile monogram (variant B): F and K share one stem.
// Cyan stem + top bar form the F, the white angles form the K.
interface Props {
  size?: number;
  inverse?: boolean;
  class?: string;
}
const { size = 40, inverse = false, class: className } = Astro.props;
const tile = inverse ? '#1BA1E2' : '#232325';
const fk = inverse ? '#FFFFFF' : '#1BA1E2';
const angles = inverse ? '#232325' : '#FFFFFF';
const clipId = `fk-clip-${inverse ? 'inv' : 'std'}`;
---
<svg class={className} width={size} height={size} viewBox="0 0 100 100" role="img" aria-label="FK Solution Design">
  <defs>
    <clipPath id={clipId}><rect x="36" y="22" width="44" height="56" /></clipPath>
  </defs>
  <rect width="100" height="100" rx="22" fill={tile} />
  <g clip-path={`url(#${clipId})`} stroke={angles} stroke-width="12" stroke-linecap="butt">
    <line x1="36" y1="50" x2="86" y2="0" />
    <line x1="36" y1="50" x2="86" y2="100" />
  </g>
  <rect x="24" y="22" width="12" height="56" fill={fk} />
  <rect x="24" y="22" width="26" height="12" fill={fk} />
</svg>
