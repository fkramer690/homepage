---
// One chapter of the masterclass, laid out like a blog article: takeaways, body,
// optional FAQ, articles for the chapter, previous/next chapter, author box and
// contact section. A Markdown file only provides body and frontmatter (docs/masterclass.md).
import Page from '../layouts/Page.astro';
import ExternalMark from './ExternalMark.astro';
import ContactForm from './ContactForm.astro';
import AuthorBox from './AuthorBox.astro';
import Blueprint from './Blueprint.astro';
import { render } from 'astro:content';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { site, contactHref, contactExternal } from '../site';
import { postHref, formatDate } from '../lib/blog';
import { homeHref } from '../lib/paths';
import {
  type Chapter,
  chapterHref,
  chapterTotal,
  chapterReadingMinutes,
  getChapters,
  getChapterTranslation,
  masterclassIndex,
  postsForKeys,
} from '../lib/masterclass';

interface Props {
  chapter: Chapter;
}
const { chapter } = Astro.props;
const { lang, title, description, takeaways, faq, articles, updatedDate } = chapter.data;
const no = chapter.data.chapter;
const t = lang === 'de' ? de : en;
const m = t.masterclass;
const { Content } = await render(chapter);
const translation = await getChapterTranslation(chapter);
const posts = await postsForKeys(lang, articles);
const chapters = await getChapters(lang);
const index = chapters.findIndex((c) => c.id === chapter.id);
const prev = index > 0 ? chapters[index - 1] : undefined;
const next = index >= 0 && index < chapters.length - 1 ? chapters[index + 1] : undefined;

const alternates = translation
  ? lang === 'de'
    ? { en: chapterHref(translation), de: chapterHref(chapter) }
    : { en: chapterHref(chapter), de: chapterHref(translation) }
  : undefined;
const url = new URL(chapterHref(chapter), Astro.site).href;
const hub = new URL(masterclassIndex(lang), Astro.site).href;
const base = import.meta.env.BASE_URL;
const abs = (path: string) => new URL(path, Astro.site).href;
const ctaAttrs = contactExternal ? { target: '_blank', rel: 'noopener' } : {};
const suffix = ' | FK Solution Design';
const pageTitle = title.length + suffix.length <= 60 ? title + suffix : title;
const ogImage = `${base}og/${lang}/masterclass/${chapter.data.slug}.png`;
const nn = (n: number) => String(n).padStart(2, '0');
const eyebrow = m.chapterEyebrow.replace('{nn}', nn(no)).replace('{n}', String(no)).replace('{total}', String(chapterTotal));
const chapterLabel = (c: Chapter) => m.chapterNo.replace('{nn}', nn(c.data.chapter));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Article', 'LearningResource'],
      '@id': `${url}#article`,
      headline: title,
      name: title,
      description,
      abstract: takeaways.join(' '),
      ...(updatedDate && { dateModified: updatedDate.toISOString() }),
      inLanguage: lang,
      mainEntityOfPage: url,
      image: abs(ogImage),
      position: no,
      learningResourceType: 'Chapter',
      educationalLevel: 'Professional',
      wordCount: (chapter.body ?? '').split(/\s+/).filter(Boolean).length,
      author: { '@type': 'Person', '@id': `${abs(base)}#person`, name: site.person, url: site.linkedin, jobTitle: 'Salesforce Enterprise Architect' },
      publisher: { '@type': 'Organization', '@id': `${abs(base)}#organization`, name: site.company },
      isPartOf: { '@type': 'CollectionPage', '@id': `${hub}#page`, name: m.title, url: hub },
    },
    ...(faq.length > 0
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${url}#faq`,
            inLanguage: lang,
            mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
          },
        ]
      : []),
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'FK Solution Design', item: abs(homeHref(lang)) },
        { '@type': 'ListItem', position: 2, name: m.name, item: hub },
        { '@type': 'ListItem', position: 3, name: title, item: url },
      ],
    },
  ],
};
---
<Page lang={lang} title={pageTitle} description={description} alternates={alternates} ogType="article" image={ogImage} hasContact>
  <Fragment slot="head">
    <meta property="article:author" content={site.person} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <article class="section post mc-chapter">
    <div class="container post-inner">
      <a class="post-back mono" href={masterclassIndex(lang)}>← {m.back}</a>
      <p class="eyebrow mono">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="post-meta mono">
        {site.person}
        {updatedDate && <> · {t.blog.updated} <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, lang)}</time></>}
        {' · '}{chapterReadingMinutes(chapter)} {t.blog.readingTime}
      </p>
      <aside class="post-takeaways" aria-label={t.blog.takeaways}>
        <p class="label mono">{t.blog.takeaways}</p>
        <ul>
          {takeaways.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
      <div class="prose">
        <Content />
      </div>
      {faq.length > 0 && (
        <section class="post-faq" aria-labelledby="faq">
          <h2 id="faq">{t.blog.faq}</h2>
          {faq.map(({ q, a }) => (
            <details class="faq-item">
              <summary><h3>{q}</h3></summary>
              <p>{a}</p>
            </details>
          ))}
        </section>
      )}
      {posts.length > 0 && (
        <nav class="post-related" aria-label={m.chapterArticles}>
          <p class="label mono">{m.chapterArticles}</p>
          <ul>
            {posts.map((p) => <li><a href={postHref(p)}>{p.data.title}</a></li>)}
          </ul>
        </nav>
      )}
      {(prev || next) && (
        <nav class="mc-pager" aria-label={m.pagerLabel}>
          {prev ? (
            <a class="post-service mc-pager-prev" href={chapterHref(prev)} rel="prev">
              <span class="label mono">← {m.prev} · {chapterLabel(prev)}</span>
              <span class="post-service-title">{prev.data.short}</span>
            </a>
          ) : <span />}
          {next && (
            <a class="post-service mc-pager-next" href={chapterHref(next)} rel="next">
              <span class="label mono">{m.next} · {chapterLabel(next)} →</span>
              <span class="post-service-title">{next.data.short}</span>
            </a>
          )}
        </nav>
      )}
      <AuthorBox lang={lang} />
    </div>
  </article>
  <section class="contact dark grid-bg" id="contact">
    <Blueprint />
    <div class="container contact-inner">
      <div class="contact-intro">
        <p class="label mono">{t.contact.label}</p>
        <h2>{m.ctaTitle}</h2>
        <p class="contact-text">{m.ctaText}</p>
        <a class="btn" href={contactHref(`${m.name}: ${title}`)} {...ctaAttrs}>{t.nav.cta}{contactExternal && <ExternalMark label={t.nav.newTab} />}</a>
        {contactExternal && <p class="booking-note">{t.contact.bookingNote}</p>}
      </div>
      <ContactForm t={t} subject={`${t.contact.form.subject}: ${m.formSubject}: ${title}`} />
    </div>
  </section>
</Page>
