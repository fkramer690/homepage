---
// Placeholder for an About subpage whose content is still being written.
import Page from '../layouts/Page.astro';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { site } from '../site';

interface Props {
  lang: 'en' | 'de';
  page: 'speaking' | 'certifications';
}
const { lang, page } = Astro.props;
const t = lang === 'de' ? de : en;
const p = t.subpages[page];
const base = import.meta.env.BASE_URL;
const home = lang === 'de' ? `${base}de/` : base;
---
<Page lang={lang} title={p.metaTitle} description={p.intro} alternates={{ en: `${base}${page}/`, de: `${base}de/${page}/` }} noindex>
  <section class="section blog">
    <div class="container blog-inner">
      <p class="eyebrow mono">{t.about.title}</p>
      <h1>{p.title}</h1>
      <p class="blog-intro">{p.intro}</p>
      <p class="subpage-tbd mono">TBD</p>
      <p>{t.subpages.tbd} <a class="text-link" href={site.linkedin} rel="noopener">{t.about.linkedin} →</a></p>
      <p><a class="text-link" href={`${home}#about`}>← {t.subpages.back}</a></p>
    </div>
  </section>
</Page>
