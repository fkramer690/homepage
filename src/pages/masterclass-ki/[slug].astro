---
// Old addresses of the AI masterclass chapters, kept as redirects (see src/lib/masterclass.ts).
import Redirect from '../../components/Redirect.astro';
import { chapterHref, getChapters } from '../../lib/masterclass';

export async function getStaticPaths() {
  const chapters = await getChapters('de');
  return chapters.map((chapter) => ({ params: { slug: chapter.data.slug }, props: { to: chapterHref(chapter) } }));
}
const { to } = Astro.props;
---
<Redirect to={to} />
