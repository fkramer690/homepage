---
import Redirect from '../../../components/Redirect.astro';
import { getPosts, postHref } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts('de');
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { to: postHref(post) } }));
}
const { to } = Astro.props;
---
<Redirect to={to} />
