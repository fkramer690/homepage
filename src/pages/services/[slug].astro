---
import Redirect from '../../components/Redirect.astro';
import { getServices, serviceHref } from '../../lib/services';

// The English service pages moved to /en/services/.
export async function getStaticPaths() {
  const services = await getServices('en');
  return services.map((service) => ({ params: { slug: service.data.slug }, props: { to: serviceHref(service) } }));
}
const { to } = Astro.props;
---
<Redirect to={to} />
