---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { en } from '../i18n/en';

interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Base lang="de" title={`${title} – FK Solution Design`} description={title} noindex>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header t={en} home={base} switchHref={`${base}de/`} />
  <main id="main" class="section legal">
    <div class="container legal-inner">
      <h1>{title}</h1>
      <slot />
    </div>
  </main>
  <Footer t={en} switchHref={`${base}de/`} />
</Base>
