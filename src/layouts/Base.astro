---
import '@fontsource/sora/400.css';
import '@fontsource/sora/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

interface Props {
  lang: 'en' | 'de';
  title: string;
  description: string;
  alternates?: { en: string; de: string };
  noindex?: boolean;
}
const { lang, title, description, alternates, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const abs = (path: string) => new URL(path, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {alternates && (
      <>
        <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
        <link rel="alternate" hreflang="de" href={abs(alternates.de)} />
        <link rel="alternate" hreflang="x-default" href={abs(alternates.en)} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#232325" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={abs(`${base}og-image.png`)} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
