---
// Shell for content pages (blog) in either language.
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import BlockMotion from '../components/BlockMotion.astro';
import { en } from '../i18n/en';
import { de } from '../i18n/de';
import { homeHref } from '../lib/paths';

interface Props {
  lang: 'en' | 'de';
  title: string;
  description: string;
  alternates?: { en: string; de: string };
  ogType?: 'website' | 'article';
  image?: string;
  // True when the page has its own #contact section (blog articles).
  hasContact?: boolean;
  noindex?: boolean;
  // Width system (docs/layouts.md): 'reading' pages put their text into
  // ReadingGrid, 'wide' pages (overviews, start page) use the full frame.
  layout: 'reading' | 'wide';
}
const { lang, title, description, alternates, ogType, image, hasContact = false, noindex = false, layout } = Astro.props;
const t = lang === 'de' ? de : en;
const home = homeHref(lang);
const switchHref = alternates ? (lang === 'de' ? alternates.en : alternates.de) : homeHref(lang === 'de' ? 'en' : 'de');
---
<Base lang={lang} title={title} description={description} alternates={alternates} ogType={ogType} image={image} noindex={noindex}>
  <slot name="head" slot="head" />
  <a class="skip-link" href="#main">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>
  <Header t={t} home={home} switchHref={switchHref} />
  <main id="main" data-layout={layout}>
    <slot />
  </main>
  <FloatingContact t={t} messageHref={hasContact ? '#contact' : `${home}#contact`} />
  <Footer t={t} switchHref={switchHref} />
  <BlockMotion />
</Base>
