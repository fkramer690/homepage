---
// Shell for content pages (blog) in either language.
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import { en } from '../i18n/en';
import { de } from '../i18n/de';

interface Props {
  lang: 'en' | 'de';
  title: string;
  description: string;
  alternates?: { en: string; de: string };
  ogType?: 'website' | 'article';
  image?: string;
  // True when the page has its own #contact section (blog articles).
  hasContact?: boolean;
}
const { lang, title, description, alternates, ogType, image, hasContact = false } = Astro.props;
const t = lang === 'de' ? de : en;
const base = import.meta.env.BASE_URL;
const home = lang === 'de' ? `${base}de/` : base;
const switchHref = alternates ? (lang === 'de' ? alternates.en : alternates.de) : lang === 'de' ? base : `${base}de/`;
---
<Base lang={lang} title={title} description={description} alternates={alternates} ogType={ogType} image={image}>
  <slot name="head" slot="head" />
  <a class="skip-link" href="#main">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>
  <Header t={t} home={home} switchHref={switchHref} />
  <main id="main">
    <slot />
  </main>
  <FloatingContact t={t} messageHref={hasContact ? '#contact' : `${home}#contact`} />
  <Footer t={t} switchHref={switchHref} />
</Base>
